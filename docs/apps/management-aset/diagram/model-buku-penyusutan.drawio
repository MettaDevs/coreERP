          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="s2" source="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="d2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=14;" value="3. HASIL PADA ASET" vertex="1">
          <mxGeometry height="700" width="400" x="1030" y="110" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Aset tercatat, tetapi mentok&lt;/b&gt;&lt;br&gt;&lt;br&gt;Status tetap &lt;i&gt;received&lt;/i&gt; dan tidak dapat ditempatkan.&lt;br&gt;&lt;br&gt;&lt;i&gt;Ini disengaja: menandakan matriks belum diisi, bukan mode &quot;tanpa penyusutan&quot;.&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="360" x="20" y="170" as="geometry" />
        </mxCell>
        <mxCell id="gr1" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Buku aktif dan menyusut&lt;/b&gt;&lt;br&gt;&lt;br&gt;depreciate = true&lt;br&gt;Periode penyusutan dihitung tiap bulan." vertex="1">
          <mxGeometry height="110" width="360" x="20" y="400" as="geometry" />
        </mxCell>
        <mxCell id="o1" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Buku aktif, tidak menyusut&lt;/b&gt;&lt;br&gt;&lt;br&gt;depreciate = false&lt;br&gt;Nilai perolehan tetap tercatat, angkanya tidak pernah berubah." vertex="1">
          <mxGeometry height="110" width="360" x="20" y="560" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=12;strokeColor=#b85450;" target="r1" value="tidak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=12;strokeColor=#82b366;" target="gr1" value="ya, dikapitalisasi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=12;strokeColor=#d79b00;" target="o1" value="tidak, di bawah ambang">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;Yang perlu diketahui QA&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Buku hanya dibentuk &lt;b&gt;sekali&lt;/b&gt;, pada saat aset diterima.&lt;br&gt;2. Menambah baris matriks setelah itu &lt;b&gt;tidak berlaku surut&lt;/b&gt; — aset lama tetap dengan buku lamanya. Belum ada mekanisme backfill.&lt;br&gt;3. Mengubah matriks juga tidak menulis ulang aset yang sudah berjalan. Ini disengaja, supaya angka aset berjalan tidak berubah diam-diam.&lt;br&gt;4. Saat aset dilepas, seluruh buku aktifnya ditutup sekaligus — berapa pun jumlahnya." vertex="1">
          <mxGeometry height="170" width="900" x="520" y="840" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;" value="Keterangan warna" vertex="1">
