  <diagram name="1. Alur pembentukan buku" id="0">
    <mxGraphModel dx="1440" dy="643" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Bagaimana buku penyusutan sebuah aset terbentuk" vertex="1">
          <mxGeometry height="36" width="900" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="t1b" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" value="Petugas tidak pernah memilih buku. Buku dihasilkan otomatis dari konfigurasi group aset." vertex="1">
          <mxGeometry height="24" width="900" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=14;" value="1. SETUP — admin, sekali di awal" vertex="1">
          <mxGeometry height="480" width="400" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="g1" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Group aset&lt;/b&gt;&lt;br&gt;Sumbu finansial aset.&lt;br&gt;Contoh: Tanah, Kendaraan,&lt;br&gt;Peralatan kantor.&lt;br&gt;&lt;i&gt;Punya ambang kapitalisasi&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="170" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Buku penyusutan&lt;/b&gt;&lt;br&gt;Master buku yang tersedia.&lt;br&gt;• Buku komersial&lt;br&gt;• Buku fiskal / pajak" vertex="1">
          <mxGeometry height="110" width="170" x="210" y="70" as="geometry" />
        </mxCell>
        <mxCell id="m1" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Matriks group × buku&lt;/b&gt;&lt;br&gt;&lt;br&gt;Satu baris = satu buku untuk group itu.&lt;br&gt;&lt;br&gt;Tiap baris menyimpan:&lt;br&gt;• profil penyusutan&lt;br&gt;• masa manfaat&lt;br&gt;• konvensi&lt;br&gt;• flag &lt;b&gt;depreciate&lt;/b&gt; (hitung / tidak)&lt;br&gt;&lt;br&gt;&lt;i&gt;Di sinilah seluruh keputusan dibuat.&lt;/i&gt;" vertex="1">
          <mxGeometry height="190" width="360" x="20" y="250" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="s1" source="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" target="m1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="s1" source="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" target="m1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=14;" value="2. SAAT ASET DITERIMA — otomatis" vertex="1">
          <mxGeometry height="700" width="420" x="520" y="100" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="s2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Petugas mengisi form aset&lt;br&gt;&lt;i&gt;(group, nilai perolehan, tanggal)&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="30" y="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="s2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Group punya baris&lt;br&gt;di matriks?" vertex="1">
          <mxGeometry height="100" width="300" x="60" y="170" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="s2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Buat 1 buku aset untuk setiap baris matriks&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aturan matriks &lt;b&gt;disalin&lt;/b&gt; ke buku,&lt;br&gt;bukan dirujuk hidup-hidup." vertex="1">
          <mxGeometry height="100" width="360" x="30" y="330" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="s2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Nilai perolehan ≥&lt;br&gt;ambang kapitalisasi group?" vertex="1">
          <mxGeometry height="120" width="330" x="45" y="490" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="s2" source="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="d1" value="">
