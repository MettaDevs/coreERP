        </mxCell>
        <mxCell id="lg1" parent="legend" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="" vertex="1">
          <mxGeometry height="16" width="30" x="14" y="36" as="geometry" />
