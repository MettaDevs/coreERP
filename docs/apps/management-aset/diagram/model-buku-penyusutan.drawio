          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;Satu-satunya pengecualian per aset: ambang kapitalisasi&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dua aset di group yang sama bisa berbeda perlakuan &lt;b&gt;hanya berdasarkan nilainya&lt;/b&gt;.&lt;br&gt;Contoh: group Peralatan Kantor dengan ambang Rp 1.000.000&lt;br&gt;• Laptop Rp 15.000.000 → menyusut&lt;br&gt;• Kursi Rp 400.000 → tercatat, tidak menyusut&lt;br&gt;&lt;br&gt;Ini otomatis. Admin tidak memilih apa pun per aset." vertex="1">
          <mxGeometry height="200" width="720" x="40" y="600" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;Yang belum bisa — dan itu keputusan sadar&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Matriks kosong bukan sebuah mode.&lt;/b&gt; Aset akan tertahan di status received. Itu jaring pengaman agar admin yang lupa setup langsung ketahuan.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Mengecualikan satu aset secara manual belum bisa.&lt;/b&gt; Kalau satu mesin perlu perlakuan berbeda dari mesin lain di group yang sama, hari ini jalannya adalah membuat group tersendiri.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Menambah buku ke aset lama belum bisa.&lt;/b&gt; Butuh fitur backfill tersendiri." vertex="1">
          <mxGeometry height="200" width="720" x="800" y="600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
