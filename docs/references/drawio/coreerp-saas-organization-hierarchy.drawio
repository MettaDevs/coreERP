        <mxCell id="b-op1" value="1 · ORGANIZATION LIFECYCLE&#xa;Create organization → classify legal entity/operating unit → assign one or more hierarchy purposes → edit draft version → validate → publish with effective date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="b-ops"><mxGeometry x="70" y="70" width="820" height="100" as="geometry"/></mxCell>
        <mxCell id="b-op2" value="2 · PERMANENT MULTI-POSITION ACCESS&#xa;Assign worker to one or more positions → automatic/manual rule assigns multiple roles → each role receives organization scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="b-ops"><mxGeometry x="70" y="210" width="820" height="100" as="geometry"/></mxCell>
