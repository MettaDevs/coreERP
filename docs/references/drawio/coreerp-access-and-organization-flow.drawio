<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="module-access" name="1 - Akses Modul">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Mengapa produk yang dipilih saat registrasi belum bisa dibuka?" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Data tenant saat diperiksa&#xa;&#xa;2 hak produk aktif&#xa;2 job pemasangan mengantre&#xa;0 placement&#xa;0 role bisnis" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Registrasi bisnis&#xa;memilih produk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Hak produk dibuat&#xa;aktif" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Worker pemasangan&#xa;sudah menjalankan job?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="100" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Belum&#xa;&#xa;Job tetap mengantre.&#xa;Produk belum dipasang." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="300" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Artifact ditempatkan&#xa;Migration berhasil&#xa;Runtime siap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="300" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Pengguna punya role bisnis&#xa;dengan izin modul?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="290" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Belum&#xa;&#xa;Produk tetap tidak muncul&#xa;di launcher." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Produk dapat dibuka" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="760" y="500" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Tenant owner / admin&#xa;&#xa;Menyusun role bisnis dan assignment.&#xa;System role tidak otomatis menjadi izin transaksi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Provider control plane&#xa;&#xa;Menjalankan worker dan infrastruktur deployment, lalu mencatat hasil pemasangan sebenarnya." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="490" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Kesimpulan: hak produk sudah benar. Hambatan sekarang ada dua: worker belum memproses antrean dan belum ada role bisnis. Launcher sengaja menolak sampai keduanya selesai." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="1">
