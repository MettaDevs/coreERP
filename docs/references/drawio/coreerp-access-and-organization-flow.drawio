  <diagram id="organization-model" name="2 - Model Organisasi Microsoft">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Model organisasi CoreERP yang mengikuti Microsoft Dynamics 365" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="50" as="geometry" /></mxCell>
        <mxCell id="3" value="Tenant&#xa;Batas kontrak dan isolasi&#xa;bukan root organisasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="4" value="Direktori organisasi&#xa;Identitas stabil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="5" value="Legal entity&#xa;&#xa;Badan hukum, ledger, pajak,&#xa;mata uang, laporan resmi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="270" height="120" as="geometry" /></mxCell>
        <mxCell id="6" value="Operating unit&#xa;&#xa;Pembagian sumber daya dan&#xa;proses operasional" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="250" width="270" height="120" as="geometry" /></mxCell>
        <mxCell id="7" value="Tipe kanonik Microsoft&#xa;&#xa;Business unit&#xa;Department&#xa;Cost center&#xa;Value stream&#xa;Retail channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="1110" y="230" width="300" height="170" as="geometry" /></mxCell>
        <mxCell id="8" value="Purpose&#xa;&#xa;Menentukan proses bisnis yang memakai susunan dan jenis organisasi yang diizinkan" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="270" height="140" as="geometry" /></mxCell>
        <mxCell id="9" value="Hierarchy&#xa;&#xa;Satu sudut pandang parent-child&#xa;bukan identitas organisasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="430" width="270" height="140" as="geometry" /></mxCell>
        <mxCell id="10" value="Version&#xa;&#xa;Draft → validasi → publish&#xa;dengan tanggal berlaku" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="430" width="270" height="140" as="geometry" /></mxCell>
        <mxCell id="11" value="Placement pada version&#xa;&#xa;Legal entity sebagai root bila konsekuensi hukum/akuntansi berlaku&#xa;&#xa;Operating unit ditempatkan di bawahnya sesuai purpose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="450" width="300" height="170" as="geometry" /></mxCell>
        <mxCell id="12" value="Establishment bukan tipe operating unit&#xa;&#xa;Ia adalah operating unit yang ditempatkan dalam hierarchy efektif dengan purpose Enterprise establishment structure dan tetap berada di bawah tepat satu legal entity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="680" width="370" height="150" as="geometry" /></mxCell>
        <mxCell id="13" value="Nama hierarchy harus unik per tenant&#xa;&#xa;Target UX: validasi sebelum insert, lalu tampilkan pesan pada field. Database constraint tetap menjadi perlindungan terakhir." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="340" height="150" as="geometry" /></mxCell>
        <mxCell id="14" value="Untuk susunan legal / kebijakan yang umum: legal entity paling atas, lalu operating unit di bawahnya. Operating unit menjadi root hanya bila purpose dan proses bisnis memang membutuhkannya." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="450" y="690" width="510" height="120" as="geometry" /></mxCell>
        <mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell>
