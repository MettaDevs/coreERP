          <mxGeometry x="20" y="300" width="260" height="30" as="geometry" />
        </mxCell>

        <mxCell id="B_man" value="&lt;b&gt;Lisensi per klien (admin.erp)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Apotek Sejahtera:&lt;br&gt;&amp;nbsp;&amp;nbsp;kasir, inventory, farmasi&lt;br&gt;&lt;br&gt;Praktek dr. Budi:&lt;br&gt;&amp;nbsp;&amp;nbsp;registrasi, rawat-jalan, kasir" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="B">
          <mxGeometry x="440" y="56" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="B_ci" value="&lt;b&gt;CI: build 1 image per rilis&lt;/b&gt;&lt;br&gt;seluruh modul ikut, bahan uji dipangkas&lt;br&gt;+ build UI shell dengan modul itu&lt;br&gt;→ 1 image + compose bertanda tangan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="B">
          <mxGeometry x="440" y="270" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="B_s1" value="&lt;b&gt;Server Apotek Sejahtera&lt;/b&gt;&lt;br&gt;Image: core + kasir + inventory + farmasi&lt;br&gt;Tabel: kas_*, inv_*, far_*&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Tidak ada registrasi &amp;amp; rawat jalan: kode tidak ada di image, tabel tidak pernah dibuat&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="B">
          <mxGeometry x="860" y="56" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="B_s2" value="&lt;b&gt;Server Praktek dr. Budi&lt;/b&gt;&lt;br&gt;Image: core + registrasi + rawat-jalan + kasir&lt;br&gt;Tabel: reg_*, rj_*, kas_*&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Tidak ada farmasi &amp;amp; inventory, link module juga tidak ikut&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="B">
          <mxGeometry x="860" y="250" width="400" height="130" as="geometry" />
        </mxCell>

        <mxCell id="B_why" value="&lt;b&gt;Kenapa lebih murah dari cara sekarang:&lt;/b&gt;&lt;br&gt;• Tidak ada hapus manual: yang tidak dibeli tidak pernah di-build&lt;br&gt;• 1 image per edisi, bukan 10+ image per client&lt;br&gt;• Upgrade = ganti 1 image, jalankan migration modul terpasang&lt;br&gt;• Beli modul tambahan = ubah manifest → image baru → migration modul baru saja, data lama aman&lt;br&gt;• Proteksi lisensi cukup &quot;tidak dikirim&quot;. Odoo menambah ping mingguan, itu opsional&lt;br&gt;• Manifest, dependsOn, entitlement, rantai security yang sudah kalian buat tetap dipakai" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="B">
