          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R_gain" value="&lt;b&gt;Yang jadi lebih murah:&lt;/b&gt;&lt;br&gt;• Per server customer: 1 proses + 1 database (+ worker)&lt;br&gt;• Resep → farmasi → kasir = pemanggilan fungsi, 1 transaksi ACID&lt;br&gt;• Laporan lintas modul = SQL JOIN biasa&lt;br&gt;• 1 fitur = 1 PR per package, tanpa matriks versi runtime&lt;br&gt;• Uninstall modul = drop tabel modul itu saja (seperti Odoo / Business Central)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="R">
          <mxGeometry x="20" y="480" width="780" height="140" as="geometry" />
        </mxCell>

        <!-- ================= BOTTOM: EDITION BUNDLE FLOW ================= -->
        <mxCell id="B" value="CARA KIRIM KE ON-PREM: hanya modul yang dibeli yang di-build (pola Odoo Enterprise: kode berbayar tidak pernah sampai ke yang tidak bayar)" style="swimlane;startSize=36;fontStyle=1;fontSize=14;fillColor=#fffdf5;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1700" height="470" as="geometry" />
