        </mxCell>
        <mxCell id="problem" value="&lt;b&gt;Masalah asal:&lt;/b&gt; Apotek hanya beli Farmasi + Kasir. Praktek dokter hanya beli Registrasi + Rawat Jalan. Dulu satu source untuk semua, jadi kode dan tabel yang tidak dibeli dihapus manual per client, dan client bisa menyalakan fitur yang tidak dibayar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
