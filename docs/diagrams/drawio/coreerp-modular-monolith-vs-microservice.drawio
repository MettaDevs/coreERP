        <mxCell id="R_db" value="1 database per tenant&#xa;tabel milik tiap modul: reg_*, rj_*, far_*, inv_*, kas_*&#xa;modul lain tidak boleh tulis langsung (batas dijaga di kode, seperti Packwerk di Shopify)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="R">
          <mxGeometry x="160" y="386" width="500" height="80" as="geometry" />
