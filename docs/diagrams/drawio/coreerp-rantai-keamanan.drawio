<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Rantai keamanan CoreERP">
    <mxGraphModel dx="1200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Rantai keamanan CoreERP: dari entry point sampai user" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="zoneA" value="1 &#183; Dideklarasikan manifest app (app.yaml) &#8212; empat lapis, empat baris terpisah" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="700" height="510" as="geometry" />
        </mxCell>

        <mxCell id="entrypoint" value="Entry point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="zoneA">
          <mxGeometry x="40" y="70" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="entrypointNote" value="Yang dilindungi: form, menu item, API/service operation, report, action.&#xa;Kode: &lt;app&gt;.&lt;resource&gt;.&lt;form|api&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="zoneA">
          <mxGeometry x="330" y="70" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="permission" value="Permission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="zoneA">
          <mxGeometry x="40" y="180" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="permissionNote" value="Pasangan entry point + access level.&#xa;access: read, update, create, correct, delete, invoke.&#xa;archive/void/retire memakai delete." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="zoneA">
          <mxGeometry x="330" y="180" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="privilege" value="Privilege" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="zoneA">
          <mxGeometry x="40" y="290" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="privilegeNote" value="Satu tugas; kumpulan permission.&#xa;Kode privilege TIDAK BOLEH sama dengan kode permission &#8212; Core menolak manifestnya." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="zoneA">
          <mxGeometry x="330" y="290" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="duty" value="Duty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="zoneA">
          <mxGeometry x="40" y="400" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dutyNote" value="Bagian proses bisnis; kumpulan privilege.&#xa;Lapis terakhir yang dideklarasikan app." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="zoneA">
          <mxGeometry x="330" y="400" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="zoneB" value="2 &#183; Disusun pada tenant &#8212; bukan bagian manifest app" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="700" height="510" as="geometry" />
        </mxCell>

        <mxCell id="role" value="Security role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="zoneB">
          <mxGeometry x="40" y="70" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="roleNote" value="Kumpulan duty, boleh lintas app.&#xa;Tidak punya module_id dan tidak dimiliki department.&#xa;Hierarchy role adalah graph berarah tanpa siklus." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="zoneB">
          <mxGeometry x="330" y="70" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="assignment" value="Role assignment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="zoneB">
          <mxGeometry x="40" y="190" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="scope" value="Data policy scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="zoneB">
          <mxGeometry x="400" y="190" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="scopeNote" value="Batas organisasi per assignment.&#xa;Satu assignment boleh punya beberapa scope grant/revoke.&#xa;Kolom null berarti tidak dibatasi." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="zoneB">
          <mxGeometry x="400" y="264" width="270" height="48" as="geometry" />
        </mxCell>

        <mxCell id="membership" value="Tenant membership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="zoneB">
          <mxGeometry x="40" y="320" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="membershipNote" value="Kaitan user dengan tenant, beserta role platform&#xa;owner / admin / user." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="zoneB">
          <mxGeometry x="330" y="320" width="340" height="50" as="geometry" />
        </mxCell>

        <mxCell id="user" value="User" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="zoneB">
          <mxGeometry x="40" y="420" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="+ access level" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zoneA" source="entrypoint" target="permission">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="dikumpulkan jadi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zoneA" source="permission" target="privilege">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="dikumpulkan jadi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zoneA" source="privilege" target="duty">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="admin tenant memilih duty yang diperlukan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="duty" target="role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="diberikan lewat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zoneB" source="role" target="assignment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="melekat pada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zoneB" source="assignment" target="membership">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zoneB" source="membership" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="membatasi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="zoneB" source="scope" target="assignment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="runtime" value="Runtime: Core memperluas hierarchy role lebih dulu, lalu menerbitkan permission efektif dan scope pada token konteks bertanda tangan. App menerima hak warisan persis seperti hak langsung, dan tidak pernah mengetahui hierarchy role." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="700" height="70" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Keterangan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="1">
