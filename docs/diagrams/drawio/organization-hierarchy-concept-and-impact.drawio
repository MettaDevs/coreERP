        <mxCell id="15" value="Procurement pusat&#xa;Operating unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="12"><mxGeometry x="250" y="180" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="16" value="Tidak menyimpan parent atau level tetap" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#4b5563;" vertex="1" parent="12"><mxGeometry x="65" y="265" width="320" height="25" as="geometry"/></mxCell>
        <mxCell id="17" value="Satu susunan bisa dipakai beberapa tujuan&#xa;bila relasi induk–anaknya memang sama" style="swimlane;startSize=30;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="390" width="790" height="320" as="geometry"/></mxCell>
        <mxCell id="18" value="4 tujuan yang tersedia sekarang" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2937;" vertex="1" parent="17"><mxGeometry x="30" y="45" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="19" value="Business policy&#xa;Kebijakan berlaku ke unit mana?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="17"><mxGeometry x="30" y="90" width="160" height="70" as="geometry"/></mxCell>
