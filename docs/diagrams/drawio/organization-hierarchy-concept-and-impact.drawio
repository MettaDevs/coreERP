  <diagram name="Core dinamis, module tetap punya aturan">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Agar CoreERP dinamis: core memberi batas dan konteks; module memiliki aturan bisnis" style="text;html=1;fontSize=23;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="3" value="Core bersama" style="swimlane;startSize=30;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="350" height="500" as="geometry"/></mxCell>
        <mxCell id="4" value="Konteks tepercaya&#xa;tenant · badan usaha · unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="3"><mxGeometry x="40" y="55" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="5" value="Directory organisasi&#xa;+ hierarchy/version efektif" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="3"><mxGeometry x="40" y="150" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="6" value="Identity dan akses&#xa;role → permission → scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="3"><mxGeometry x="40" y="245" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="7" value="Contract dan event&#xa;untuk integrasi antarmodule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="3"><mxGeometry x="40" y="340" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="8" value="Core tidak menyimpan&#xa;aturan pembelian, aset, atau HR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="3"><mxGeometry x="40" y="430" width="270" height="45" as="geometry"/></mxCell>
        <mxCell id="9" value="Module Procurement" style="swimlane;startSize=30;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="430" height="500" as="geometry"/></mxCell>
        <mxCell id="10" value="Aturan yang dikonfigurasi customer&#xa;limit · kategori · vendor · unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="9"><mxGeometry x="45" y="55" width="340" height="65" as="geometry"/></mxCell>
        <mxCell id="11" value="Versi aturan + tanggal berlaku&#xa;aturan lama tidak ditulis ulang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="9"><mxGeometry x="45" y="150" width="340" height="65" as="geometry"/></mxCell>
        <mxCell id="12" value="Purchase request&#xa;menentukan badan usaha dan unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="9"><mxGeometry x="45" y="255" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="13" value="Resolver policy&#xa;cari aturan paling spesifik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="9"><mxGeometry x="230" y="255" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="14" value="Approval/task + audit&#xa;siapa memutuskan dan kapan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="9"><mxGeometry x="45" y="370" width="340" height="65" as="geometry"/></mxCell>
        <mxCell id="15" value="Bukan builder bebas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="980" y="100" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="16" value="Customer boleh mengubah nilai dan memilih opsi yang disediakan module; tidak menciptakan langkah/permission sembarang." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="980" y="225" width="340" height="105" as="geometry"/></mxCell>
        <mxCell id="17" value="Ekstrak menjadi capability core hanya setelah dipakai setidaknya dua module&#xa;contoh: task approval, definition version, audit event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="980" y="395" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="18" value="Mindset implementasi Procurement" style="swimlane;startSize=30;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1280" height="190" as="geometry"/></mxCell>
        <mxCell id="19" value="1. Simpan konteks transaksi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="18"><mxGeometry x="30" y="55" width="220" height="60" as="geometry"/></mxCell>
