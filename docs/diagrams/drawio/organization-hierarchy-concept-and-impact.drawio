        <mxCell id="23" value="Tambah purpose baru hanya bila ada relasi induk–anak yang berbeda&#xa;dan ada proses pemakai yang jelas. Bukan untuk membuat level baru." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="17"><mxGeometry x="80" y="205" width="630" height="65" as="geometry"/></mxCell>
