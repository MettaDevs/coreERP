  <diagram name="Mulai dari kosong">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Saat pertama kali organisasi masih kosong" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="3" value="Yang dibuat otomatis saat registrasi" style="swimlane;startSize=30;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="230" as="geometry"/></mxCell>
        <mxCell id="4" value="User + owner&#xa;+ tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="3"><mxGeometry x="40" y="70" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="5" value="Bukan organisasi paling atas&#xa;dan bukan bentuk struktur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="3"><mxGeometry x="40" y="160" width="220" height="45" as="geometry"/></mxCell>
        <mxCell id="6" value="Yang user isi lebih dulu" style="swimlane;startSize=30;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="390" y="90" width="350" height="230" as="geometry"/></mxCell>
        <mxCell id="7" value="1. Legal entity minimal satu&#xa;Nama · kode · data badan hukum/pajak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="6"><mxGeometry x="35" y="55" width="280" height="75" as="geometry"/></mxCell>
        <mxCell id="8" value="2. Tambahkan operating unit hanya bila nyata&#xa;Contoh: department, cabang, outlet, cost center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="6"><mxGeometry x="35" y="150" width="280" height="65" as="geometry"/></mxCell>
        <mxCell id="9" value="Butuh relasi induk–anak&#xa;untuk proses tertentu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="10" value="Tidak&#xa;Selesai. Satu legal entity boleh bekerja tanpa hierarchy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="11" value="Ya&#xa;Buat hierarchy dari organisasi yang sudah ada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="220" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="12" value="Direktori organisasi: identitasnya stabil" style="swimlane;startSize=30;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="450" height="320" as="geometry"/></mxCell>
        <mxCell id="13" value="PT LEAK STUDIO&#xa;Legal entity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="12"><mxGeometry x="135" y="55" width="180" height="60" as="geometry"/></mxCell>
