<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0" agent="Codex">
  <diagram id="setup-access" name="Panduan setup akses">
    <mxGraphModel dx="1200" dy="760" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Panduan setup akses — contoh yang ada di website sekarang" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#17324d;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="3" value="Urutan teknis: Entry point → Permission → Privilege → Duty → Security role → Orang + batas data.&#xa;Urutan admin di website: pilih duty ke role, lalu berikan role dan batas data ke orang." style="text;html=1;fontSize=14;fontColor=#52616b;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1350" height="45" as="geometry"/></mxCell>

        <mxCell id="10" value="A. Didaftarkan oleh aplikasi&#xa;(belum tampil sebagai layar admin)" style="swimlane;html=1;startSize=42;fontStyle=1;fontColor=#17324d;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="910" height="285" as="geometry"/></mxCell>
        <mxCell id="11" value="1. ENTRY POINT&#xa;&#xa;Yang dilindungi:&#xa;• layar daftar register aset&#xa;• API tambah/ubah register aset&#xa;• aksi arsipkan aset&#xa;&#xa;Di website: belum ada daftar entry point." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="10"><mxGeometry x="20" y="65" width="200" height="185" as="geometry"/></mxCell>
        <mxCell id="12" value="2. PERMISSION&#xa;&#xa;Hak pada entry point:&#xa;• Lihat register aset&#xa;• Tambah register aset&#xa;• Ubah register aset&#xa;• Arsipkan register aset&#xa;&#xa;Di website: belum ditampilkan sebagai checkbox terpisah." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="10"><mxGeometry x="245" y="65" width="200" height="185" as="geometry"/></mxCell>
        <mxCell id="13" value="3. PRIVILEGE&#xa;&#xa;Paket permission untuk satu tugas kecil:&#xa;• Pelihara register aset&#xa;  = lihat + tambah + ubah&#xa;• Arsipkan register aset&#xa;  = arsipkan&#xa;&#xa;Di website: belum ada layar privilege." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="10"><mxGeometry x="470" y="65" width="200" height="185" as="geometry"/></mxCell>
        <mxCell id="14" value="4. DUTY&#xa;&#xa;Paket privilege untuk tanggung jawab bisnis:&#xa;&#xa;Kelola register aset&#xa;= pelihara + arsipkan register aset&#xa;&#xa;INILAH yang tampil sebagai checkbox di website." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=13;fontStyle=1;" vertex="1" parent="10"><mxGeometry x="695" y="65" width="195" height="185" as="geometry"/></mxCell>
        <mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="10" source="11" target="12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="10" source="12" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="10" source="13" target="14"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="20" value="B. Disetel oleh admin tenant di website" style="swimlane;html=1;startSize=36;fontStyle=1;fontColor=#17324d;fillColor=#edf5fb;strokeColor=#5b9bd5;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1330" height="390" as="geometry"/></mxCell>
        <mxCell id="21" value="5. SECURITY ROLE&#xa;&#xa;Nama role: Staff GA&#xa;&#xa;Di layar “Tanggung jawab bisnis”, admin mencentang duty:&#xa;✓ Kelola entitas aset&#xa;✓ Kelola group aset&#xa;✓ Kelola kategori aset&#xa;✓ Kelola jenis aset&#xa;✓ Kelola kondisi aset&#xa;✓ Kelola pabrikan aset&#xa;✓ Kelola item checklist maintenance&#xa;✓ Kelola analisa maintenance&#xa;✓ Kelola register aset&#xa;&#xa;Artinya: role Staff GA menerima semua duty tersebut." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=13;fontStyle=1;" vertex="1" parent="20"><mxGeometry x="25" y="60" width="385" height="285" as="geometry"/></mxCell>
        <mxCell id="22" value="6. BERIKAN ROLE KE ORANG&#xa;&#xa;Di layar undangan / Atur akses anggota:&#xa;✓ Staff GA&#xa;&#xa;Artinya: orang tersebut mendapatkan semua duty yang ada di role Staff GA.&#xa;&#xa;Department orang bukan pengganti langkah ini." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="20"><mxGeometry x="465" y="60" width="350" height="235" as="geometry"/></mxCell>
        <mxCell id="23" value="7. BATAS DATA&#xa;&#xa;Di bagian “Batas data — Akses aset menurut unit penanggung jawab”:&#xa;• pilih Badan hukum&#xa;• pilih Unit kerja&#xa;• bila perlu, pilih “Sertakan unit di bawahnya”&#xa;&#xa;Artinya: duty dari Staff GA hanya berlaku pada aset dalam batas unit yang dipilih." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="20"><mxGeometry x="870" y="60" width="400" height="235" as="geometry"/></mxCell>
        <mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#5b9bd5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="20" source="21" target="22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="25" value="tambahkan batas data" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="20" source="22" target="23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="26" value="HASIL: orang tersebut dapat melakukan tindakan dari semua duty Staff GA, tetapi hanya atas aset yang unit penanggung jawabnya berada dalam batas data yang dipilih." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="145" y="900" width="1120" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
