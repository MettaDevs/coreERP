  <diagram name="Alur petugas">
    <mxGraphModel dx="1220" dy="2470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="2500" math="0" shadow="0">
