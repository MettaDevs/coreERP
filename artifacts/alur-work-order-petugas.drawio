  <diagram name="Setup hingga Work Order">
    <mxGraphModel dx="1240" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s-title" value="Alur Setup Maintenance hingga Work Order Selesai" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s-note" value="Ikuti nomor 1–10 saat menyiapkan sistem pertama kali. Setup tidak perlu diulang untuk setiap work order." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="80" width="880" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s-lane-a" value="A. Dasar pekerjaan" style="swimlane;html=1;startSize=35;horizontal=1;collapsible=0;container=1;pointerEvents=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="160" width="1200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1. Bidang keahlian&#xa;Siapkan bidang pelaksana, misalnya mekanik atau elektrik." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="s-lane-a">
          <mxGeometry x="120" y="60" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Jenis pekerjaan&#xa;Tentukan pekerjaan yang dapat dipilih pada aset dan work order." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="s-lane-a">
          <mxGeometry x="720" y="60" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s-lane-b" value="B. Checklist dan bawaan pekerjaan" style="swimlane;html=1;startSize=35;horizontal=1;collapsible=0;container=1;pointerEvents=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="350" width="1200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Pilihan jawaban checklist&#xa;Opsional: buat pilihan seperti Baik, Perlu perbaikan, atau Gagal." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="s-lane-b">
          <mxGeometry x="50" y="60" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Template checklist&#xa;Susun apa yang harus diperiksa, instruksi, nilai, dan item wajib." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="s-lane-b">
          <mxGeometry x="450" y="60" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Bawaan pekerjaan&#xa;Hubungkan jenis pekerjaan, template checklist, perkiraan jam, dan kondisi aset." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="s-lane-b">
          <mxGeometry x="850" y="60" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s-lane-c" value="C. Aturan work order" style="swimlane;html=1;startSize=35;horizontal=1;collapsible=0;container=1;pointerEvents=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="1200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. Tipe work order&#xa;Atur jenis dan batas penugasan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="s-lane-c">
          <mxGeometry x="20" y="65" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. Tingkat layanan&#xa;Atur prioritas atau urgensi." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="s-lane-c">
          <mxGeometry x="260" y="65" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="8. Sebab kerusakan&#xa;Siapkan pilihan diagnosis mekanik." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="s-lane-c">
          <mxGeometry x="500" y="65" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="9. Tindakan perbaikan&#xa;Siapkan pilihan hasil pekerjaan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="s-lane-c">
          <mxGeometry x="740" y="65" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="10. Syarat penyelesaian&#xa;Tentukan data yang wajib lengkap sebelum selesai." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="s-lane-c">
          <mxGeometry x="980" y="65" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s-lane-d" value="D. Pelaksanaan work order" style="swimlane;html=1;startSize=35;horizontal=1;collapsible=0;container=1;pointerEvents=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="770" width="1200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="Buat work order&#xa;Pilih aset, pekerjaan, mekanik, dan jadwal. Checklist bawaan disalin otomatis." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="s-lane-d">
          <mxGeometry x="20" y="60" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="Jadwalkan&#xa;Pekerjaan muncul di Pekerjaan saya milik mekanik." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="s-lane-d">
          <mxGeometry x="260" y="60" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="Mekanik mengerjakan&#xa;Buka checklist, periksa aset, dan lakukan perbaikan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="s-lane-d">
          <mxGeometry x="500" y="60" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="Catat hasil dan selesaikan&#xa;Isi checklist, jam, sebab, dan tindakan perbaikan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="s-lane-d">
          <mxGeometry x="740" y="60" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="Tinjau dan tutup&#xa;Petugas berwenang memeriksa hasil lalu menutup work order." style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="s-lane-d">
          <mxGeometry x="980" y="60" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s-legacy" value="Catatan: Item checklist maintenance dan Analisa maintenance tetap tersedia paling bawah pada sidebar sebagai halaman legacy. Keduanya bukan bagian dari urutan setup utama." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="1000" width="920" height="60" as="geometry" />
