        <mxCell id="21" value="Buat work order baru&#xa;Status: Draf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="10">
