.DS_Store
.env
.env.*
!.env.example
node_modules/
dist/
vendor/
# `vendor/` di atas juga cocok dengan folder fitur `Vendor` di Windows, karena git di sana tidak
# membedakan huruf besar; berkas baru di fitur itu akan diam-diam tidak ikut ter-commit.
!apps/core/app/Foundation/Vendor/
!apps/core/resources/js/pages/foundation/vendor/
!apps/core/tests/Feature/Foundation/Vendor/
public/build/
public/hot
storage/*.key
storage/pail/
.phpunit.cache/
.phpunit.result.cache
__pycache__/
*.pyc
.vite-wayfinder.stdout.log
.vite-wayfinder.stderr.log

# VitePress
docs/.vitepress/dist/
docs/.vitepress/cache/

# Kunci SSH lokal, jangan pernah di-commit
.codex-server-migrate*
*-ed25519
*-ed25519.pub

# Penanda sekali pakai milik `scripts/periksa-sisa-mesin.sh`. Ia menanamnya ke dalam konteks
# pembangunan lalu menghapusnya; baris ini menjaga agar satu jalan yang terhenti di tengah tidak
# meninggalkan berkas yang ikut ter-commit.
apps/core/resources/penanda-kendali.txt
docs/references/Screenshot
