# Setelan pemasangan CoreERP di server ini, dibaca `docker compose --env-file` lewat update.sh.
#
# Dibuat SEKALI oleh deploy/agent/pasang.sh dari berkas contoh ini, dan tidak pernah ditimpanya lagi.
# Isian bertanda at-ganda diisi saat itu; rahasianya dibuat di server ini dengan `openssl rand` dan tidak
# pernah dikirim ke admin.erp. Hanya root yang dapat membaca berkas hasilnya.
#
# Setiap variabel `${...}` di deploy/compose.edition.yaml disebut di sini, kecuali EDITION_IMAGE:
# nilai itu disetel update.sh untuk setiap pembaruan dari manifest rilis, dan menaruhnya di sini hanya
# akan terlihat seperti setelan padahal selalu ditimpa.
#
# Jangan memakai tanda `$` atau `#` pada nilai yang ditulis tangan: Compose membaca `$` sebagai awal
# variabel dan `#` sebagai awal komentar.

# --- Wajib, diisi pasang.sh ----------------------------------------------------------------------------

APP_URL=@@APP_URL@@
CORE_APP_KEY=@@CORE_APP_KEY@@
CORE_DB_PASSWORD=@@CORE_DB_PASSWORD@@
COREERP_PROVIDER_EMAIL=@@COREERP_PROVIDER_EMAIL@@
COREERP_PROVIDER_PASSWORD=@@COREERP_PROVIDER_PASSWORD@@

# Folder lisensi yang ditulis agen situs; di-mount hanya-baca ke container Core.
COREERP_LICENSE_DIR=@@COREERP_LICENSE_DIR@@

# Lisensi mengunci. Satu image membawa seluruh modul, jadi lisensi satu-satunya yang membatasi app yang
# boleh dibuka; tanpa lisensi yang sah, pengguna tenant terkunci dan akun provider tetap masuk. Templat ini
# hanya dipakai on-prem dikelola — pemasangan beli-putus tidak memakainya dan tetap pada bawaan compose,
# false. Baris ini dapat diubah root di server; agen melaporkan nilainya, dan admin.erp memperingatkan.
COREERP_LICENSE_REQUIRED=true

# --- Bawaan yang lazim tidak diubah --------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false
# Keduanya dapat disebut saat memasang: pasang.sh --app-port PORT --app-bind ALAMAT.
CORE_APP_PORT=8000
# Hanya loopback. CoreERP dilayani lewat reverse proxy klien, dan port yang diterbitkan Docker melewati
# firewall host — aturan UFW tidak berlaku untuknya — jadi port yang diikat ke semua alamat terbuka ke
# internet walaupun firewall-nya terlihat menutupnya. Reverse proxy yang berjalan di dalam Docker tidak
# menjangkau loopback host; untuk bentuk itu sebut alamat gateway bridge Docker (lihat
# `docker network inspect bridge`), bukan 127.0.0.1.
CORE_APP_BIND=127.0.0.1
# CoreERP ditempatkan di belakang reverse proxy yang sudah ada di server klien. Tanpa HTTPS di depannya,
# cookie sesi yang aman tidak pernah dikirim balik dan tidak ada yang dapat masuk.
SESSION_SECURE_COOKIE=true
COREERP_TRUSTED_PROXIES=

# --- Laporan kesalahan dan event: mati secara bawaan, lihat komentar di compose.edition.yaml ----------

COREERP_SIGNOZ_URL=
COREERP_DISCORD_WEBHOOK_URL=
COREERP_DISCORD_MENTION=
COREERP_DISCORD_JEDA_DETIK=60
COREERP_EVENT_ENDPOINTS=[]

# --- Telemetri: mati. Menyalakannya WAJIB menyebut alamat kolektor milik klien sendiri ---------------

OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_DEPLOYMENT_ENVIRONMENT=on-prem
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PHP_DISABLED_INSTRUMENTATIONS=psr3
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_PROPAGATORS=baggage,tracecontext
OTEL_PHP_LOG_DESTINATION=none
