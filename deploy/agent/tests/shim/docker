#!/usr/bin/env bash
#
# `docker` tiruan untuk menguji agen dan update.sh tanpa Docker sungguhan di dalam container uji.
#
# Ia tidak menirukan Docker; ia hanya menjawab perintah yang dipanggil kedua skrip itu, dan mencatat
# setiap pemanggilan supaya pengujian dapat memeriksa apa yang diminta:
#
#   FAKE_DOCKER_LOG          satu baris per pemanggilan, argumen digabung spasi. Image yang ada juga dicatat
#                            di sini sebagai baris `# ada REF` dan `# tag TUJUAN SUMBER`, supaya mengosongkan
#                            log sekaligus mengosongkan image yang dianggap ada
#   FAKE_DOCKER_LOG_LENGKAP  sama, tetapi tidak pernah dikosongkan pengujian
#   FAKE_DOCKER_JSON_LOG     satu objek JSON per pemanggilan: {"args": [...], "edition_image": "...", "docker_config": "..."}
#   FAKE_DOCKER_LOGIN_LOG    satu objek JSON per `docker login`, tanpa kata sandinya: registry, pengguna, sha256
#                            stdin, DOCKER_CONFIG, mode foldernya, dan jumlah berkas di bawah COREERP_HOME dan TMPDIR
#                            yang memuat kata sandi itu saat login
#
# Setelan perilaku:
#
#   FAKE_DOCKER_ROOT          jawaban `docker info --format {{.DockerRootDir}}`
#   FAKE_DOCKER_IMAGE_ADA     image yang dianggap sudah ada sebelum ditarik, dipisah spasi
#   FAKE_DOCKER_IMAGE_ID      id image yang dijawab `docker image inspect` (bawaan, atau --format berisi .Id)
#   FAKE_DOCKER_REPO_DIGESTS  pasangan REF=REPO_DIGEST dipisah spasi, dijawab `--format` berisi RepoDigests untuk
#                             REF itu. Tanpa pasangan, image yang ditarik lewat digest menjawab rujukannya sendiri,
#                             dan tag menjawab RepoDigests sumbernya — seperti Docker
#   FAKE_DOCKER_REPO_DIGEST_PALSU  potongan teks; RepoDigests yang memuatnya dijawab dengan digest lain
#   FAKE_DOCKER_REGISTRY_PRIVAT    host yang menuntut `docker login` di DOCKER_CONFIG sebelum pull
#   FAKE_DOCKER_LOGIN_GAGAL   1 membuat login ditolak
#   FAKE_DOCKER_PULL_401      1 membuat setiap pull ditolak unauthorized
#   FAKE_DOCKER_PULL_401_SEKALI  berkas penanda; pull pertama sesudah berkas itu tidak ada ditolak unauthorized
#   FAKE_DOCKER_PULL_JEDA     detik tidur sebelum pull menjawab
#   FAKE_DOCKER_PGDUMP_GAGAL  1 membuat pg_dump gagal
#   FAKE_DOCKER_CONFIG_GAGAL  1 membuat `compose config` gagal, seperti compose yang tidak terbaca
#   FAKE_DOCKER_UP_GAGAL      pola glob atas seluruh argumen; `compose up` yang cocok gagal seperti port yang terpakai
#   FAKE_KATA_SANDI           kata sandi sementara yang dicetak tenant:bootstrap-site tiruan
#
# `compose config --services` menjawab layanan compose.edition.yaml yang menyala. core-proxy hanya bila profil
# `proxy` menyala: COMPOSE_PROFILES di lingkungan proses bila disetel, selain itu baris terakhirnya di --env-file —
# urutan yang sama dengan Compose. Isi berkas compose-nya tidak dibaca.
#
# tenant:bootstrap-site dengan --admin-password-hash-stdin membaca stdin seperti Core:
#
#   FAKE_DOCKER_STDIN           berkas tempat stdin terakhir disalin persis, untuk membuktikan hash lewat stdin
#   FAKE_DOCKER_GEMA_STDIN      1 mencetak stdin ke keluaran — Core yang keliru — untuk menguji saringan agen
#   FAKE_DOCKER_BOOTSTRAP_EXIT  kode keluar; bukan 0 menirukan Core yang menolak
#
# finance-postings:summary menjawab ringkasan feed posting finance, seperti Core:
#
#   FAKE_DOCKER_RINGKASAN       keluaran stdout persis, boleh kosong; tanpanya ringkasan sah dengan semua jumlah nol
#   FAKE_DOCKER_RINGKASAN_EXIT  kode keluar; bukan 0 menirukan rilis Core yang belum punya perintahnya
#   FAKE_DOCKER_RINGKASAN_JEDA  detik tidur sebelum menjawab, untuk Core yang macet

set -euo pipefail

log="${FAKE_DOCKER_LOG:-/dev/null}"
semua="$*"
printf '%s\n' "$semua" >> "$log"

# Salinan yang tidak pernah dikosongkan pengujian, untuk memeriksa sesuatu yang tidak pernah dipanggil
# sepanjang seluruh putaran uji.
[ -z "${FAKE_DOCKER_LOG_LENGKAP:-}" ] || printf '%s\n' "$*" >> "$FAKE_DOCKER_LOG_LENGKAP"

# JSON disusun di bash, bukan dengan `jq --args`: jq tetap membaca argumen berawalan minus sesudah
# --args sebagai opsinya sendiri, dan `docker pull --quiet` lalu gagal karena jq, bukan karena Docker.
teks_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '"%s"' "$s"
}

if [ -n "${FAKE_DOCKER_JSON_LOG:-}" ]; then
    {
        printf '{"args":['
        pemisah=''
        for satu in "$@"; do
            printf '%s%s' "$pemisah" "$(teks_json "$satu")"
            pemisah=','
        done
        printf '],"edition_image":%s,"docker_config":%s}\n' "$(teks_json "${EDITION_IMAGE:-}")" "$(teks_json "${DOCKER_CONFIG:-}")"
    } >> "$FAKE_DOCKER_JSON_LOG"
fi

# Folder config yang dipakai Docker sungguhan: DOCKER_CONFIG, atau ~/.docker bila tidak disetel.
folder_config() {
    printf '%s' "${DOCKER_CONFIG:-$HOME/.docker}"
}

# Sumber tag TUJUAN yang terakhir dicatat, atau kosong.
sumber_tag() {
    awk -v r="$1" '$1 == "#" && $2 == "tag" && $3 == r { s = $4 } END { print s }' "$log" 2>/dev/null || true
}

ada_image() {
    local ref="$1" satu sumber

    for satu in ${FAKE_DOCKER_IMAGE_ADA:-}; do
        [ "$satu" != "$ref" ] || return 0
    done

    grep -qxF "# ada $ref" "$log" 2>/dev/null && return 0
    grep -qx 'load' "$log" 2>/dev/null && return 0

    sumber="$(sumber_tag "$ref")"
    [ -n "$sumber" ] && ada_image "$sumber" && return 0
    return 1
}

repo_digests() {
    local ref="$1" satu keluaran='' sumber

    for satu in ${FAKE_DOCKER_REPO_DIGESTS:-}; do
        [ "${satu%%=*}" != "$ref" ] || keluaran="$keluaran${satu#*=}"$'\n'
    done

    if [ -z "$keluaran" ]; then
        sumber="$(sumber_tag "$ref")"
        if [ -n "$sumber" ]; then
            keluaran="$(repo_digests "$sumber")"$'\n'
        elif [[ "$ref" == *@sha256:* ]]; then
            keluaran="$ref"$'\n'
        fi
    fi

    if [ -n "${FAKE_DOCKER_REPO_DIGEST_PALSU:-}" ] && [[ "$keluaran" == *"$FAKE_DOCKER_REPO_DIGEST_PALSU"* ]]; then
        keluaran="$(printf '%s' "$keluaran" | sed -E 's/@sha256:[0-9a-f]{64}/@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee/')"$'\n'
    fi

    printf '%s' "$keluaran" | sed '/^$/d'
}

tolak_unauthorized() {
    printf 'Error response from daemon: Head "https://%s/v2/": unauthorized: unauthorized to access repository: %s, action: pull\n' \
        "$1" "$2" >&2
    exit 1
}

case "${1:-}" in
    info)
        [ "${2:-}" != --format ] || printf '%s\n' "${FAKE_DOCKER_ROOT:-/}"
        ;;
    volume)
        # `volume ls` menjawab FAKE_DOCKER_VOLUME (satu nama per baris) — volume stack lain di server. Selain itu
        # tetap gagal, seperti volume yang tidak ada: update.sh membaca titik data database lewat `volume inspect`.
        if [ "${2:-}" = ls ]; then
            [ -z "${FAKE_DOCKER_VOLUME:-}" ] || printf '%s\n' "$FAKE_DOCKER_VOLUME"
            exit 0
        fi
        exit 1
        ;;
    load)
        cat > /dev/null
        ;;
    login)
        shift
        registry='' pengguna='' dari_stdin=0
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --username | -u) pengguna="$2"; shift 2 ;;
                --password-stdin) dari_stdin=1; shift ;;
                --password | -p) printf 'tiruan: kata sandi di argumen ditolak\n' >&2; exit 2 ;;
                *) registry="$1"; shift ;;
            esac
        done
        [ "$dari_stdin" -eq 1 ] || { printf 'tiruan: login tanpa --password-stdin ditolak\n' >&2; exit 2; }

        # Dibaca utuh, termasuk baris baru di ujung: sidik stdin harus membuktikan kata sandi dikirim persis.
        IFS= read -r -d '' sandi || true
        folder="$(folder_config)"

        if [ -n "${FAKE_DOCKER_LOGIN_LOG:-}" ]; then
            tertulis=0
            for tempat in "${COREERP_HOME:-}" "${TMPDIR:-}"; do
                if [ -z "$sandi" ] || [ -z "$tempat" ] || [ ! -d "$tempat" ]; then
                    continue
                fi
                # Pola lewat process substitution, bukan argumen: tiruan ini pun tidak menaruh kata sandi di
                # daftar proses atau di berkas.
                jumlah="$(grep -rlF -f <(printf '%s\n' "$sandi") "$tempat" 2>/dev/null | wc -l || true)"
                tertulis=$((tertulis + jumlah))
            done
            printf '{"registry":%s,"username":%s,"stdin_sha256":%s,"docker_config":%s,"mode_config":%s,"sandi_tertulis":%s}\n' \
                "$(teks_json "$registry")" "$(teks_json "$pengguna")" \
                "$(teks_json "$(printf '%s' "$sandi" | sha256sum | cut -c1-64)")" \
                "$(teks_json "${DOCKER_CONFIG:-}")" "$(teks_json "$(stat -c %a "$folder" 2>/dev/null || true)")" \
                "$tertulis" >> "$FAKE_DOCKER_LOGIN_LOG"
        fi

        if [ "${FAKE_DOCKER_LOGIN_GAGAL:-0}" = 1 ]; then
            printf 'Error response from daemon: login attempt to https://%s/v2/ failed with status: 401 Unauthorized\n' "$registry" >&2
            exit 1
        fi

        # Seperti Docker tanpa credential helper: kredensial ditulis base64 ke config.json.
        mkdir -p "$folder"
        printf '{"auths":{"%s":{"auth":"%s"}}}\n' "$registry" "$(printf '%s:%s' "$pengguna" "$sandi" | base64 -w0)" \
            > "$folder/config.json"
        printf 'Login Succeeded\n'
        ;;
    logout)
        folder="$(folder_config)"
        [ ! -f "$folder/config.json" ] || printf '{"auths":{}}\n' > "$folder/config.json"
        printf 'Removing login credentials for %s\n' "${2:-}"
        ;;
    pull)
        ref="${!#}"
        host="${ref%%/*}"

        [ -z "${FAKE_DOCKER_PULL_JEDA:-}" ] || sleep "$FAKE_DOCKER_PULL_JEDA"

        if [ -n "${FAKE_DOCKER_REGISTRY_PRIVAT:-}" ] && [ "$host" = "$FAKE_DOCKER_REGISTRY_PRIVAT" ]; then
            grep -qF "\"$host\":{\"auth\"" "$(folder_config)/config.json" 2>/dev/null || tolak_unauthorized "$host" "${ref#*/}"
            [ "${FAKE_DOCKER_PULL_401:-0}" != 1 ] || tolak_unauthorized "$host" "${ref#*/}"
            if [ -n "${FAKE_DOCKER_PULL_401_SEKALI:-}" ] && [ ! -e "$FAKE_DOCKER_PULL_401_SEKALI" ]; then
                : > "$FAKE_DOCKER_PULL_401_SEKALI"
                tolak_unauthorized "$host" "${ref#*/}"
            fi
        fi

        printf '# ada %s\n' "$ref" >> "$log"
        printf '%s\n' "$ref"
        ;;
    tag)
        if ! ada_image "${2:-}"; then
            printf 'Error response from daemon: No such image: %s\n' "${2:-}" >&2
            exit 1
        fi
        printf '# tag %s %s\n' "${3:-}" "${2:-}" >> "$log"
        ;;
    image)
        [ "${2:-}" = inspect ] || exit 1
        shift 2
        format='' ref=''
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --format | -f) format="$2"; shift 2 ;;
                --format=*) format="${1#--format=}"; shift ;;
                *) ref="$1"; shift ;;
            esac
        done
        if ! ada_image "$ref"; then
            printf 'Error: No such image: %s\n' "$ref" >&2
            exit 1
        fi
        case "$format" in
            *RepoDigests*) repo_digests "$ref" ;;
            *) printf '%s\n' "${FAKE_DOCKER_IMAGE_ID:-sha256:tiruan}" ;;
        esac
        ;;
    inspect)
        printf 'healthy\n'
        ;;
    compose)
        shift
        berkas_env=''
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --env-file) berkas_env="$2"; shift 2 ;;
                --project-name | -p | -f) shift 2 ;;
                *) break ;;
            esac
        done

        case "${1:-}" in
            version)
                printf 'Docker Compose version v2.0.0-tiruan\n'
                ;;
            config)
                if [ "${FAKE_DOCKER_CONFIG_GAGAL:-0}" = 1 ]; then
                    printf 'yaml: line 7: mapping values are not allowed in this context (tiruan)\n' >&2
                    exit 15
                fi
                if [ -n "${COMPOSE_PROFILES+disetel}" ]; then
                    profil="$COMPOSE_PROFILES"
                elif [ -n "$berkas_env" ] && [ -f "$berkas_env" ]; then
                    profil="$(sed -n 's/^COMPOSE_PROFILES=//p' "$berkas_env" | tail -n 1)"
                else
                    profil=''
                fi
                printf '%s\n' core-db core-migrate core-app core-worker core-scheduler core-renderer
                case ",$profil," in
                    *,proxy,*) printf 'core-proxy\n' ;;
                esac
                ;;
            up)
                # shellcheck disable=SC2053 # sisi kanan memang pola glob
                if [ -n "${FAKE_DOCKER_UP_GAGAL:-}" ] && [[ "$semua" == $FAKE_DOCKER_UP_GAGAL ]]; then
                    printf 'Error response from daemon: Bind for 0.0.0.0:443 failed: port is already allocated (tiruan)\n' >&2
                    exit 1
                fi
                ;;
            ls)
                # Proyek compose yang sudah ada di server, dalam bentuk `compose ls --format json`.
                printf '%s\n' "${FAKE_DOCKER_COMPOSE_LS:-[]}"
                ;;
            ps)
                if [ "${2:-}" = -q ]; then
                    printf 'c0ffee\n'
                    exit 0
                fi
                # Kunci Labels sengaja ikut di sini: agen tidak boleh meneruskannya ke laporan.
                printf '%s\n' \
                    '{"Service":"core-app","State":"running","Health":"healthy","Labels":"rahasia=jangan-dikirim"}' \
                    '{"Service":"core-db","State":"running","Health":""}'
                ;;
            exec)
                shift
                [ "${1:-}" != -T ] || shift
                case "$*" in
                    'core-db pg_dump'*)
                        if [ "${FAKE_DOCKER_PGDUMP_GAGAL:-0}" = 1 ]; then
                            printf 'pg_dump: koneksi ditolak (tiruan)\n' >&2
                            exit 1
                        fi
                        printf 'PGDMP-tiruan'
                        ;;
                    'core-app php artisan tenant:bootstrap-site'*' --admin-password-hash-stdin'*)
                        stdin="${FAKE_DOCKER_STDIN:-$(mktemp)}"
                        cat > "$stdin"

                        [ "${FAKE_DOCKER_GEMA_STDIN:-0}" != 1 ] || printf 'stdin yang diterima: %s\n' "$(cat "$stdin")"

                        if [ "${FAKE_DOCKER_BOOTSTRAP_EXIT:-0}" != 0 ]; then
                            printf 'Tenant sudah ada di server ini, tetapi owner-nya bukan admin yang diminta (tiruan).\n' >&2
                            exit "$FAKE_DOCKER_BOOTSTRAP_EXIT"
                        fi

                        printf 'Tenant lahir (tiruan).\n'
                        ;;
                    'core-app php artisan tenant:bootstrap-site'*)
                        printf 'Tenant dilahirkan.\nKata sandi sementara: %s\n' "${FAKE_KATA_SANDI:-RahasiaSementara-123}"
                        ;;
                    'core-app php artisan finance-postings:summary')
                        [ -z "${FAKE_DOCKER_RINGKASAN_JEDA:-}" ] || sleep "$FAKE_DOCKER_RINGKASAN_JEDA"

                        # Rilis Core yang belum punya perintahnya menjawab seperti Symfony Console.
                        if [ "${FAKE_DOCKER_RINGKASAN_EXIT:-0}" != 0 ]; then
                            printf '\n  ERROR  Command "finance-postings:summary" is not defined.\n\n' >&2
                            exit "$FAKE_DOCKER_RINGKASAN_EXIT"
                        fi

                        # `-`, bukan `:-`: FAKE_DOCKER_RINGKASAN yang disetel kosong menirukan Core yang tidak mencetak apa pun.
                        bawaan='{"counts":{"held":0,"pending":0,"posted":0,"rejected":0,"manual":0},"oldest_pending_at":null,"last_pulled_at":null,"last_pushed_at":null}'
                        printf '%s\n' "${FAKE_DOCKER_RINGKASAN-$bawaan}"
                        ;;
                esac
                ;;
        esac
        ;;
esac
