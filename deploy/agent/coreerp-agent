perintah_enroll() {
    local alamat='' token='' isi jawaban kode galat

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --admin-url) [ "$#" -ge 2 ] || gagal '--admin-url menuntut satu alamat.'; alamat="$2"; shift 2 ;;
            --token) [ "$#" -ge 2 ] || gagal '--token menuntut satu token.'; token="$2"; shift 2 ;;
            *) gagal "Argumen tidak dikenal: $1" ;;
        esac
    done

    if [ -z "$alamat" ] || [ -z "$token" ]; then
        gagal 'Pemakaian: coreerp-agent enroll --admin-url URL --token TOKEN'
    fi

    alamat="${alamat%/}"
    periksa_alamat_admin "$alamat"

    if [ -e "$BERKAS_SITUS" ] || [ -e "$KUNCI_SITUS" ]; then
        gagal \
            'Situs ini sudah terdaftar.' \
            '' \
            "Kunci situs yang ada tidak ditimpa: $FOLDER_AGEN" \
            'Kunci itu yang dikenal admin.erp. Menimpanya memutus situs ini dari pengelolaan, dan tidak ada' \
            'jalan kembali dari sini. Bila memang harus mendaftar ulang, pindahkan foldernya dengan sadar.'
    fi

    # Kunci situs lahir di server ini dan kunci privatnya tidak pernah keluar. Token pendaftaran hanya
    # dipakai sekali untuk mengantar kunci publik; ia tidak pernah menjadi kredensial jangka panjang.
    buat_kunci "$SEMENTARA/site-key.pem" "$SEMENTARA/site-public.pem"

    isi="$SEMENTARA/enroll.json"
    jawaban="$SEMENTARA/enroll-jawaban.json"

    jq -c -n --arg token "$token" --rawfile kunci "$SEMENTARA/site-public.pem" --arg versi "$AGEN_VERSI" \
        '{token: $token, public_key: $kunci, agent_version: $versi}' > "$isi"

    langkah "Mendaftarkan situs ke $alamat"

    kode="$(curl --silent --show-error --proto '=https,http' --connect-timeout 15 --max-time 60 \
        --output "$jawaban" --write-out '%{http_code}' \
        --request POST \
        --header 'Content-Type: application/json' --header 'Accept: application/json' \
        --header "User-Agent: coreerp-agent/$AGEN_VERSI" \
        --data-binary "@$isi" "$alamat/api/agent/v1/enroll" 2>>"$SEMENTARA/curl-galat")" || kode='000'

    if [ "$kode" != 201 ]; then
        galat="$(jq -r '.error // empty' "$jawaban" 2>/dev/null || true)"
        gagal \
            "admin.erp menolak pendaftaran (HTTP $kode${galat:+, $galat})." \
            '' \
            'Token pendaftaran hanya berlaku sekali dan kedaluwarsa dalam satu jam. Minta perintah pasang' \
            'yang baru dari halaman situs di admin.erp.'
    fi

    SITUS_ID="$(jq -r '.site_id // "" | tostring' "$jawaban")"
    id_sah "$SITUS_ID" || gagal 'admin.erp menjawab dengan id situs yang tidak sah.'

    siapkan_folder

    if jq -e '(.license_public_key | type) == "string"' "$jawaban" >/dev/null; then
        jq -j '.license_public_key' "$jawaban" > "$FOLDER_LISENSI/license-public.pem"
        chmod 0644 "$FOLDER_LISENSI/license-public.pem"
    fi

    jq -e '(.tenant_id | type) == "string" and (.tenant_name | type) == "string"' "$jawaban" >/dev/null 2>&1 \
        || gagal 'Jawaban pendaftaran admin.erp tidak memuat tenant_id dan tenant_name.'

    jq -n --arg alamat "$alamat" --slurpfile j "$jawaban" '
        $j[0] as $d
        | {
            site_id: $d.site_id,
            tenant_id: $d.tenant_id,
            tenant_name: $d.tenant_name,
            admin_url: $alamat,
            interval_seconds: $d.interval_seconds,
            update_window: $d.update_window
          }' > "$BERKAS_SITUS.baru"

    mv -f "$SEMENTARA/site-key.pem" "$KUNCI_SITUS"
    mv -f "$SEMENTARA/site-public.pem" "$KUNCI_SITUS_PUBLIK"
    mv -f "$BERKAS_SITUS.baru" "$BERKAS_SITUS"
    pastikan_keadaan

    printf '    terdaftar sebagai situs %s\n' "$SITUS_ID"
    printf '\nRilis pertama dipasang lewat operasi install dari admin.erp, bukan dari server ini.\n'
}

perintah_run() {
    local paksa=0 interval terakhir kode jawaban hasil

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --now) paksa=1; shift ;;
            *) gagal "Argumen tidak dikenal: $1" ;;
        esac
    done

    muat_situs

    # Timer tidak menyalakan unit yang masih berjalan, tetapi `run` juga dapat dijalankan tangan. Tanpa
    # kunci ini dua putaran dapat mengambil dua operasi dan menjalankan dua update.sh sekaligus.
    exec 9>>"$BERKAS_KUNCI_PUTARAN"
    if ! flock -n 9; then
        catat 'Putaran agen lain masih berjalan; putaran ini dilewati.'
        exit 0
    fi

    periksa_alamat_admin "$SITUS_ADMIN"

    # Timer berdetak tiap menit; admin.erp yang menentukan seberapa sering agen benar-benar datang.
    # Toleransi 15 detik menyerap jitter timer, supaya interval 60 detik tidak berubah jadi 120.
    if [ "$paksa" -eq 0 ]; then
        interval="$(jq -r '.interval_seconds // 60 | tostring' "$BERKAS_SITUS")"
        terakhir="$(jq -r '.last_report_epoch // 0 | tostring' "$BERKAS_KEADAAN")"
        cocok "$interval" '^[0-9]+$' || interval=60
        cocok "$terakhir" '^[0-9]+$' || terakhir=0

        if [ "$(( $(date +%s) - terakhir + 15 ))" -lt "$interval" ]; then
            exit 0
        fi
    fi

    kode="$(kirim_laporan)"

    case "$kode" in
        200) ;;
        000) gagal 'admin.erp tidak dapat dihubungi.' "$(tail -n 3 "$SEMENTARA/curl-galat" 2>/dev/null || true)" ;;
        401) gagal 'admin.erp menolak tanda tangan situs ini (401).' \
            'Situs mungkin dicabut, atau kuncinya sudah diganti di tempat lain.' ;;
        *) catat "Laporan tidak diterima admin.erp (HTTP $kode); operasi tetap ditanyakan." ;;
    esac

    printf '{}' > "$SEMENTARA/klaim.json"
    jawaban="$SEMENTARA/operasi.json"
    kode="$(panggil POST /api/agent/v1/operations/claim "$SEMENTARA/klaim.json" "$jawaban")"

    case "$kode" in
        204) exit 0 ;;
        200) ;;
        *) gagal "Gagal menanyakan operasi ke admin.erp (HTTP $kode)." ;;
    esac

    jq -e 'type == "object"' "$jawaban" >/dev/null 2>&1 || gagal 'Jawaban operasi dari admin.erp bukan objek JSON.'

    # Dijalankan di subshell dengan `set -e` sendiri. Memanggilnya dengan `|| hasil=$?` akan diam-diam
    # mematikan `set -e` untuk seluruh operasi — perilaku bash yang tidak terlihat dari membaca kodenya.
    set +e
    (
        set -e
        kerjakan_operasi "$jawaban"
    )
    hasil=$?
    set -e

    # Operasi yang pulang tanpa ditutup — dilepas admin.erp, atau jawaban ganti kunci yang hilang — tidak
    # boleh tampil sebagai sedang berjalan di terminal pemasang sampai operasi berikutnya datang.
    ubah_keadaan 'del(.current_operation)'

    # Laporan sesudah operasi supaya admin.erp melihat rilis atau cadangan baru tanpa menunggu putaran
    # berikutnya. Gagalnya tidak menggagalkan putaran: operasinya sendiri sudah dilaporkan.
    kode="$(kirim_laporan)" || true

    exit "$hasil"
}

# Melahirkan tenant di Core dengan id yang sama dengan catatan di admin.erp, beserta admin pertamanya.
#
# **Hanya dijalankan manusia di terminal**, tidak pernah dari `run` maupun timer, dan keluarannya tidak
# ditulis ke berkas atau log mana pun. Alasannya satu: `tenant:bootstrap-site` mencetak kata sandi
# sementara admin pertama. Keluaran unit systemd masuk journald, yang disimpan di disk, dibaca siapa pun
# di grup `adm`, dan kerap diteruskan ke pengumpul log. Kata sandi yang lewat di sana tidak lagi hanya
# dilihat orang yang memasang. Diteruskan ke terminal apa adanya, lalu hilang bersama terminalnya.
#
# Ia juga bukan operasi di daftar tertutup: nama dan email admin pertama diputuskan bersama klien di
# tempat, bukan dikirim admin.erp.
perintah_bootstrap_tenant() {
    local nama_admin='' email_admin='' tenant_id tenant_nama compose_sehat versi_sehat image_sehat

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --admin-name) [ "$#" -ge 2 ] || gagal '--admin-name menuntut satu nama.'; nama_admin="$2"; shift 2 ;;
            --admin-email) [ "$#" -ge 2 ] || gagal '--admin-email menuntut satu email.'; email_admin="$2"; shift 2 ;;
            *) gagal "Argumen tidak dikenal: $1" ;;
        esac
    done

    if [ -z "$nama_admin" ] || [ -z "$email_admin" ]; then
        gagal 'Pemakaian: coreerp-agent bootstrap-tenant --admin-name NAMA --admin-email EMAIL'
    fi

    muat_situs

    tenant_id="$(jq -r '.tenant_id // "" | tostring' "$BERKAS_SITUS")"
    tenant_nama="$(jq -r '.tenant_name // "" | tostring' "$BERKAS_SITUS")"

    if [ -z "$tenant_id" ] || [ -z "$tenant_nama" ]; then
        gagal \
            "$BERKAS_SITUS tidak memuat tenant_id dan tenant_name." \
            'Keduanya datang dari admin.erp saat pendaftaran; tanpa keduanya tenant lahir dengan id yang tidak dikenal admin.erp.'
    fi

    compose_sehat="$FOLDER_KEADAAN_UPDATE/compose-sehat.yaml"
    versi_sehat="$FOLDER_KEADAAN_UPDATE/versi-sehat"
    image_sehat=''
    [ ! -f "$versi_sehat" ] || image_sehat="$(cat "$versi_sehat")"

    if [ -z "$image_sehat" ] || [ ! -f "$compose_sehat" ]; then
        gagal \
            'Belum ada rilis yang terpasang dan terbukti sehat di server ini.' \
            '' \
            'Tenant dilahirkan di dalam aplikasi yang sedang berjalan. Pasang rilis pertama lebih dulu dengan' \
            'meminta "Perbarui" dari halaman situs di admin.erp.'
    fi

    [ -f "$BERKAS_ENV" ] || gagal "Berkas setelan tidak ditemukan: $BERKAS_ENV"

    # Tidak boleh berbarengan dengan pembaruan yang sedang mengganti container.
    exec 9>>"$BERKAS_KUNCI_PUTARAN"
    flock -w 120 9 || gagal 'Putaran agen lain masih berjalan lebih dari dua menit; coba lagi nanti.'

    langkah "Melahirkan tenant $tenant_nama ($tenant_id)"

    # Opsi ditulis `--opsi=nilai`, bukan `--opsi nilai`: nama yang kebetulan diawali tanda minus akan
    # dibaca Symfony Console sebagai opsi lain pada bentuk kedua.
    EDITION_IMAGE="$image_sehat" docker compose --project-name "$PROYEK" --env-file "$BERKAS_ENV" -f "$compose_sehat" \
        exec -T core-app php artisan tenant:bootstrap-site \
        "--tenant-id=$tenant_id" \
        "--name=$tenant_nama" \
        "--admin-name=$nama_admin" \
        "--admin-email=$email_admin" 9>&-
}

utama() {
    local perintah="${1:-}"

    case "$perintah" in
        '') bantuan; exit 2 ;;
        -h | --help | help) bantuan; exit 0 ;;
        --version | version) printf 'coreerp-agent %s\n' "$AGEN_VERSI"; exit 0 ;;
    esac

    shift

    # Kunci, cadangan, dan log agen hanya untuk root. Yang perlu dibaca pihak lain — folder lisensi —
    # disetel terang-terangan di tempatnya.
    umask 077
    periksa_perintah

    mkdir -p "$FOLDER_AGEN"
    chmod 0700 "$FOLDER_AGEN"
    SEMENTARA="$(mktemp -d "$FOLDER_AGEN/.sementara.XXXXXX")"
    trap 'rm -rf "$SEMENTARA"' EXIT
    : > "$SEMENTARA/kosong"

    case "$perintah" in
        enroll) perintah_enroll "$@" ;;
        run) perintah_run "$@" ;;
        bootstrap-tenant) perintah_bootstrap_tenant "$@" ;;
        *) gagal "Perintah tidak dikenal: $perintah" "$(bantuan)" ;;
    esac
}

utama "$@"
