#!/usr/bin/env bash
#
# Agen situs CoreERP untuk profil "on-prem dikelola vendor".
#
#   coreerp-agent enroll --admin-url https://admin.erp.contoh --token <token>
#   coreerp-agent run [--now]
#   coreerp-agent bootstrap-tenant --admin-name <nama> --admin-email <email>
#
# Agen ini **menarik**, bukan didorong. Server klinik hampir selalu di belakang router tanpa port masuk,
# jadi agenlah yang menyambung keluar ke admin.erp, menanyakan apakah ada operasi, mengerjakannya, lalu
# melaporkan hasilnya. Tidak ada port yang dibuka untuk CoreERP.
#
# Empat hal yang sengaja, dan tidak boleh dilonggarkan tanpa membaca alasannya:
#
# 1. **Daftar operasi tertutup, dan tertulis di sini.** admin.erp memilih operasi dan parameternya; ia
#    tidak pernah mengirim perintah shell. Operasi yang tidak dikenal ditolak dan dilaporkan gagal.
#    Daftar tertutup menjaga server klien dari admin.erp yang dibobol — bukan dari orang yang sudah
#    memegang root di server ini.
#
# 2. **Kunci publik rilis tidak pernah diganti lewat agen.** `pasang.sh` mengambilnya sekali saat
#    pemasangan pertama dan menolak kunci yang berbeda dari yang sudah terpasang; sesudah itu agen hanya
#    membacanya dari disk, dan tidak ada operasi maupun jawaban admin.erp yang menyentuhnya. admin.erp
#    yang dibobol sesudah pemasangan hanya dapat meminta rilis yang memang kami tanda tangani, bukan
#    membuat rilis baru.
#
# 3. **Rilis wajib naik.** Satu celah yang tersisa bila admin.erp dibobol adalah meminta server mundur
#    ke rilis lama yang sah tetapi bercacat keamanan. Agen menolak rilis yang tidak lebih baru dari yang
#    terpasang, dan penolakannya memakai nomor di manifest yang **ditandatangani** — bukan nomor yang
#    diminta admin.erp, yang dapat berbeda dari isi berkasnya.
#
# 4. **Laporan hanya memuat daftar tertutup** di skema `Report` pada
#    `apps/control-plane/contracts/openapi-agent.yaml`. Setiap kunci disusun satu per satu di
#    `susun_laporan`; tidak ada yang disalin utuh dari berkas atau perintah lain. Log, trace, isi tabel,
#    dan setelan rahasia tetap di server ini.
#
# Bentuk tanda tangan permintaan dan seluruh bentuk JSON-nya ditentukan kontrak di atas, bukan kode
# PHP admin.erp. Rancangannya di `docs/todo/on-prem-dikelola/README.md`.

set -euo pipefail

# Tanpa ini, perintah yang gagal di dalam `$(...)` tidak menghentikan apa pun: bash membuang `set -e`
# untuk substitusi perintah. Agen yang menyusun laporan dari keluaran jq yang gagal lalu tetap
# mengirimnya lebih buruk daripada agen yang berhenti.
shopt -s inherit_errexit

AGEN_VERSI='0.1.0'

# Didefinisikan sebelum setelan: pembacaan agent.env di bawah sudah dapat menolak.
gagal() {
    printf '\n' >&2
    printf 'GAGAL: %s\n' "$1" >&2
    shift
    [ "$#" -eq 0 ] || printf '%s\n' "$@" >&2
    exit 1
}

RUMAH="${COREERP_HOME:-/opt/coreerp}"
FOLDER_AGEN="$RUMAH/agent"
BERKAS_SETELAN="$FOLDER_AGEN/agent.env"
BERKAS_SITUS="$FOLDER_AGEN/site.json"
KUNCI_SITUS="$FOLDER_AGEN/site-key.pem"
KUNCI_SITUS_PUBLIK="$FOLDER_AGEN/site-public.pem"
KUNCI_TERTUNDA="$FOLDER_AGEN/site-key.pem.tertunda"
FOLDER_LISENSI="$FOLDER_AGEN/license"
FOLDER_RILIS="$FOLDER_AGEN/releases"
FOLDER_LOG="$FOLDER_AGEN/log"
BERKAS_KEADAAN="$FOLDER_AGEN/state.json"
BERKAS_KUNCI_PUTARAN="$FOLDER_AGEN/run.lock"

# --- Setelan server: lingkungan proses, lalu agent.env, lalu bawaan ------------------------------------
#
# agent.env dulu hanya dibaca unit systemd lewat `EnvironmentFile=`. Perintah yang dijalankan tangan lewat
# /usr/local/bin/coreerp-agent — bootstrap-tenant, run --now — tidak pernah melihatnya dan diam-diam
# memakai bawaan: bootstrap-tenant masuk ke proyek compose `coreerp` walaupun situs ini berjalan di proyek
# lain, dan pembaruan yang dijalankan run dari terminal memberi update.sh folder cadangan bawaan, bukan disk
# kedua yang disebut agent.env. Agen karena itu membacanya sendiri, supaya timer dan terminal memakai
# setelan yang sama.
#
# Berkasnya TIDAK di-`source`. Ia ditulis tangan di server klien dan dibaca proses root; baris `$(...)` di
# sana tidak boleh menjadi perintah. Hanya `KUNCI=nilai` yang diterima, dan hanya kunci di daftar di bawah —
# yang benar-benar dibaca agen atau update.sh. Nilainya dibatasi pada huruf yang dibaca sama persis oleh
# systemd dan oleh pembacaan ini: kutip, spasi, `$`, dan garis miring terbalik masing-masing diurai systemd
# dengan aturannya sendiri, dan nilai yang dibaca berbeda di dua tempat adalah cacat yang sama dengan yang
# diperbaiki di sini.
#
# Yang sengaja tidak ada di daftar: COREERP_HOME (berkas ini tinggal di bawahnya), COREERP_UPDATE_SCRIPT
# (seam pengujian, bukan setelan), dan COREERP_LEWATI_PERIKSA_CADANGAN (melewati pemeriksaan adalah
# keputusan satu kali jalan; di berkas ia diam-diam berlaku untuk setiap pembaruan sesudahnya).
SETELAN_DIIZINKAN=(
    COREERP_PROYEK
    COREERP_FOLDER_CADANGAN
    COREERP_ENV
    COREERP_KUNCI_PUBLIK
    COREERP_TITIK_DATA_DB
    COREERP_BATAS_SEHAT_DETIK
    COREERP_AGENT_DETAK_DETIK
)

muat_setelan() {
    local berkas="$1" baris sisa nomor=0 kunci nilai satu diizinkan
    local -A dari_berkas=()

    [ -f "$berkas" ] || return 0

    while IFS= read -r baris || [ -n "$baris" ]; do
        nomor=$((nomor + 1))
        sisa="${baris#"${baris%%[![:space:]]*}"}"

        case "$sisa" in
            '' | '#'* | ';'*) continue ;;
        esac

        # Baris yang ditolak disebut nomornya saja, bukan isinya: keluaran agen masuk journald, dan
        # rahasia yang keliru ditaruh di sini tidak boleh ikut tercetak.
        [[ "$baris" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || gagal \
            "$berkas baris $nomor bukan KUNCI=nilai." \
            'Berkas ini tidak dijalankan sebagai skrip. Yang diterima hanya baris KUNCI=nilai, komentar' \
            'yang diawali # atau ;, dan baris kosong.'

        kunci="${BASH_REMATCH[1]}"
        nilai="${BASH_REMATCH[2]}"
        diizinkan=0

        for satu in "${SETELAN_DIIZINKAN[@]}"; do
            [ "$satu" != "$kunci" ] || diizinkan=1
        done

        [ "$diizinkan" -eq 1 ] || gagal \
            "$berkas baris $nomor: $kunci bukan setelan yang dibaca agen." \
            "Yang diterima: ${SETELAN_DIIZINKAN[*]}"

        [[ "$nilai" =~ ^[A-Za-z0-9_./:@+-]*$ ]] || gagal \
            "$berkas baris $nomor: nilai $kunci memuat huruf yang tidak diterima." \
            'Hanya huruf, angka, dan . _ / : @ + - — tanpa kutip, spasi, $, atau garis miring terbalik.'

        # Kunci yang disebut dua kali: yang terakhir berlaku, sama dengan systemd.
        dari_berkas["$kunci"]="$nilai"
    done < "$berkas"

    # Nilai yang disebut di lingkungan proses menang: itu keputusan orang yang menjalankan perintah saat
    # itu. Di bawah systemd nilainya datang dari berkas yang sama, jadi keduanya tidak berbeda. Diekspor,
    # bukan hanya disetel, karena update.sh yang dijalankan agen membaca variabel yang sama.
    for kunci in "${!dari_berkas[@]}"; do
        [ -n "${!kunci:-}" ] || export "$kunci=${dari_berkas[$kunci]}"
    done
}

muat_setelan "$BERKAS_SETELAN"

# Nama variabel dan jalur bawaannya sama dengan `update.sh`, supaya keduanya tidak pernah memeriksa
# dengan kunci yang berbeda.
KUNCI_RILIS="${COREERP_KUNCI_PUBLIK:-$RUMAH/kunci-rilis.pub}"
FOLDER_CADANGAN="${COREERP_FOLDER_CADANGAN:-$RUMAH/cadangan}"
BERKAS_ENV="${COREERP_ENV:-$RUMAH/.env}"
PROYEK="${COREERP_PROYEK:-coreerp}"
FOLDER_KEADAAN_UPDATE="$RUMAH/keadaan"

# Lease operasi di admin.erp 15 menit, dan hanya diperpanjang oleh laporan langkah. Langkah yang lama
# tanpa keluaran — menarik image lewat sambungan klinik — dapat melewatinya, jadi langkah yang sedang
# berjalan dilaporkan ulang setiap selang ini.
DETAK_DETIK="${COREERP_AGENT_DETAK_DETIK:-300}"
[[ "$DETAK_DETIK" =~ ^[1-9][0-9]*$ ]] || DETAK_DETIK=300

SEMENTARA=''
ALASAN=''

langkah() {
    printf '\n==> %s\n' "$*"
}

catat() {
    printf '%s\n' "$*" >&2
}

tolak() {
    ALASAN="$1"
    return 1
}

sekarang_utc() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

cap_waktu() {
    date -u +%Y%m%dT%H%M%SZ
}

bantuan() {
    cat <<'TEKS'
Agen situs CoreERP.

  coreerp-agent enroll --admin-url URL --token TOKEN   mendaftarkan situs ke admin.erp
  coreerp-agent run [--now]                             satu putaran: lapor, ambil operasi, kerjakan
  coreerp-agent bootstrap-tenant --admin-name NAMA --admin-email EMAIL
                                                        melahirkan tenant dan admin pertamanya (sekali,
                                                        dari terminal, sesudah rilis pertama terpasang)

Seluruh jalur berada di bawah COREERP_HOME (bawaan /opt/coreerp). Setelan server dibaca dari
COREERP_HOME/agent/agent.env; variabel yang disebut di lingkungan perintah menang atas berkas itu.
TEKS
}

periksa_perintah() {
    local kurang=() satu

    for satu in curl jq openssl sha256sum flock docker base64 df; do
        command -v "$satu" >/dev/null 2>&1 || kurang+=("$satu")
    done

    [ "${#kurang[@]}" -eq 0 ] || gagal \
        "Perintah berikut tidak ada di PATH: ${kurang[*]}" \
        '' \
        'Agen membutuhkannya untuk berbicara dengan admin.erp, memeriksa tanda tangan, dan membaca' \
        'keadaan container. Di Ubuntu: apt-get install curl jq openssl coreutils util-linux docker.io'
}

# --- Validasi nilai yang ikut masuk ke jalur berkas, URL, dan header ----------------------------------
#
# Nilai-nilai ini datang dari admin.erp. Mereka dipakai menyusun jalur berkas dan URL, jadi bentuknya
# dibatasi sebelum dipakai: id berisi `../` akan menulis di luar folder agen, dan id berisi tanda kutip
# akan merusak header tanda tangan.

cocok() {
    [[ "$1" =~ $2 ]]
}

id_sah() {
    cocok "$1" '^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$'
}

edisi_sah() {
    cocok "$1" '^[a-z0-9][a-z0-9-]{0,79}$'
}

# Nomor rilis dibatasi pada angka bertitik tanpa nol di depan. `sort -V` mengurutkan "0.2.0-rc1"
# sesudah "0.2.0", dan "0.02" setara "0.2" tetapi tidak sama sebagai teks — keduanya membuat penolakan
# mundur dapat diakali dengan cara menulis nomornya, bukan dengan isinya.
rilis_sah() {
    [ "${#1}" -le 40 ] && cocok "$1" '^(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*)){0,5}$'
}

# "0.2" dan "0.2.0" rilis yang sama. Tanpa normalisasi, `sort -V` menilai yang kedua lebih baru.
normalkan_rilis() {
    local nilai="$1"

    while [[ "$nilai" == *.0 ]]; do
        nilai="${nilai%.0}"
    done

    printf '%s' "$nilai"
}

# Pulang 0 bila $1 lebih baru dari $2 — tidak sama, dan tidak lebih lama.
rilis_lebih_baru() {
    local baru lama

    baru="$(normalkan_rilis "$1")"
    lama="$(normalkan_rilis "$2")"

    [ "$baru" != "$lama" ] || return 1
    [ "$(printf '%s\n%s\n' "$baru" "$lama" | sort -V | tail -n 1)" = "$baru" ]
}

# admin.erp wajib dihubungi lewat HTTPS. Tanda tangan agen melindungi permintaan, tetapi jawaban
# admin.erp — operasi yang harus dikerjakan — tidak ditandatangani; tanpa TLS, siapa pun di jaringan
# klinik dapat menyisipkannya. HTTP hanya diterima ke mesin ini sendiri, yang dipakai pengujian.
periksa_alamat_admin() {
    local alamat="$1" sisa host

    # Bagian pengguna (`orang@host`) tidak pernah sah untuk admin.erp, dan ia menipu pemotong host di
    # bawah: `http://127.0.0.1:1@admin.erp.contoh` terbaca localhost, padahal curl mengirim permintaannya
    # ke admin.erp.contoh tanpa TLS.
    case "$alamat" in
        *@*) gagal "Alamat admin.erp tidak boleh memuat bagian pengguna (@): $alamat" 'Contoh yang benar: https://admin.erp.contoh' ;;
    esac

    case "$alamat" in
        https://*) ;;
        http://*)
            sisa="${alamat#http://}"
            host="${sisa%%/*}"
            host="${host%:*}"
            case "$host" in
                127.0.0.1 | localhost) ;;
                *) gagal "Alamat admin.erp harus HTTPS: $alamat" \
                    'Jawaban admin.erp tidak ditandatangani; tanpa TLS, operasinya dapat disisipkan di jaringan.' ;;
            esac
            ;;
        *) gagal "Alamat admin.erp tidak dikenali: $alamat" ;;
    esac

    sisa="${alamat#*://}"

    # Alamat hanya boleh berupa asal (skema dan host), tanpa path. `@path` yang ditandatangani harus
    # sama dengan path yang dilihat admin.erp, dan awalan path di belakang proxy membuat keduanya
    # berbeda tanpa ada yang salah di sisi mana pun.
    case "$sisa" in
        */*) gagal "Alamat admin.erp tidak boleh memuat path: $alamat" 'Contoh yang benar: https://admin.erp.contoh' ;;
    esac
}

# --- Berkas situs dan keadaan ---------------------------------------------------------------------------

siapkan_folder() {
    mkdir -p "$FOLDER_AGEN" "$FOLDER_RILIS" "$FOLDER_LOG"
    chmod 0700 "$FOLDER_AGEN"

    # Folder lisensi dibaca Core dari dalam container lewat bind mount hanya-baca, oleh pengguna yang
    # bukan root. Isinya bukan rahasia: lisensi dan kunci publik.
    mkdir -p "$FOLDER_LISENSI"
    chmod 0755 "$FOLDER_LISENSI"
}

SITUS_ID=''
SITUS_ADMIN=''

muat_situs() {
    [ -f "$BERKAS_SITUS" ] || gagal \
        "Situs ini belum terdaftar: $BERKAS_SITUS tidak ada." \
        "Daftarkan dengan \`coreerp-agent enroll\`."

    jq -e 'type == "object"' "$BERKAS_SITUS" >/dev/null 2>&1 \
        || gagal "$BERKAS_SITUS bukan JSON yang dapat dibaca."

    SITUS_ID="$(jq -r '.site_id // "" | tostring' "$BERKAS_SITUS")"
    SITUS_ADMIN="$(jq -r '.admin_url // "" | tostring' "$BERKAS_SITUS")"

    id_sah "$SITUS_ID" || gagal "Id situs di $BERKAS_SITUS tidak sah."
    [ -f "$KUNCI_SITUS" ] || gagal "Kunci situs tidak ditemukan: $KUNCI_SITUS"

    siapkan_folder
    pastikan_keadaan
}

pastikan_keadaan() {
    [ -f "$BERKAS_KEADAAN" ] || printf '{}\n' > "$BERKAS_KEADAAN"
}

# ubah_json BERKAS [argumen jq...] FILTER — menulis ke berkas sementara lalu mengganti namanya, supaya
# listrik yang padam di tengah penulisan tidak meninggalkan setengah JSON yang tidak terbaca siapa pun.
ubah_json() {
    local berkas="$1" baru
    shift
    baru="$berkas.baru.$BASHPID"

    jq "$@" "$berkas" > "$baru"
    mv -f "$baru" "$berkas"
}

ubah_keadaan() {
    pastikan_keadaan
    ubah_json "$BERKAS_KEADAAN" "$@"
}

catat_operasi_terakhir() {
    local id="$1" hasil="$2" langkah_teks="$3"

    # shellcheck disable=SC2016 # $id, $hasil, $langkah adalah variabel jq, bukan ekspansi shell
    ubah_keadaan --arg id "$id" --arg hasil "$hasil" --arg langkah "$langkah_teks" \
        '.last_operation = {id: $id, result: $hasil, step: (if $langkah == "" then null else $langkah[0:120] end)}'
}

# Jenis operasi yang sedang dikerjakan putaran ini. Diisi `kerjakan_operasi`, dibaca `tutup_operasi`.
OPERASI_JENIS=''

# Operasi yang sedang berjalan, beserta langkahnya, dicatat di state.json selama ia berjalan.
#
# Pembacanya `pasang.sh`, yang menunggu operasi `install` di terminal teknisi. `run --now` baru pulang
# sesudah operasinya selesai — bisa puluhan menit menarik image lewat sambungan klinik — jadi langkah yang
# sedang berjalan hanya dapat dibaca dari sini. Laporan ke admin.erp tidak ikut membawanya: `susun_laporan`
# menyebut kuncinya satu per satu.
catat_operasi_berjalan() {
    # shellcheck disable=SC2016 # variabel jq
    ubah_keadaan --arg id "$1" --arg jenis "$2" '.current_operation = {id: $id, operation: $jenis, release: null, step: null}'
}

catat_langkah_berjalan() {
    # shellcheck disable=SC2016 # variabel jq
    ubah_keadaan --arg langkah "$1" \
        'if (.current_operation | type) == "object" then .current_operation.step = $langkah[0:120] else . end'
}

catat_rilis_berjalan() {
    # shellcheck disable=SC2016 # variabel jq
    ubah_keadaan --arg rilis "$1" \
        'if (.current_operation | type) == "object" then .current_operation.release = $rilis else . end'
}

# Hasil operasi `install` terakhir, terpisah dari last_operation yang ditimpa operasi apa pun sesudahnya.
# `pasang.sh` yang dijalankan ulang di server yang sudah terpasang membacanya untuk tidak menunggu
# pemasangan yang sudah lama selesai. Sebab kegagalan ikut dicatat karena teknisi di depan terminal itulah
# yang paling mungkin memperbaikinya; isinya kalimat agen atau ekor keluaran update.sh dan Core, yang
# keduanya tidak pernah mencetak rahasia — dan hash kata sandi tidak pernah masuk ke sana (operasi_pasang).
catat_pemasangan_terakhir() {
    local id="$1" hasil="$2" langkah_teks="$3" pesan="$4"

    # shellcheck disable=SC2016 # variabel jq
    ubah_keadaan --arg id "$id" --arg hasil "$hasil" --arg langkah "$langkah_teks" --arg pesan "$pesan" \
        '.last_install = {
            id: $id,
            result: $hasil,
            step: (if $langkah == "" then null else $langkah[0:120] end),
            message: (if $hasil == "failed" then $pesan[0:4000] else null end)
        }'
}

buat_kunci() {
    local privat="$1" publik="$2"

    (
        umask 077
        openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out "$privat" 2>/dev/null
    )
    chmod 0600 "$privat"
    openssl pkey -in "$privat" -pubout -out "$publik" 2>/dev/null
}

# --- Tanda tangan permintaan (RFC 9421, bagian kecil yang disebut kontrak) -----------------------------
#
# panggil_bertanda METODE JALUR BERKAS_ISI BERKAS_JAWABAN [BERKAS_KUNCI]
#
# Mencetak kode status HTTP; "000" berarti tidak ada jawaban sama sekali. Bentuk signature base diambil
# persis dari kontrak: empat baris dipisah \n, tanpa \n di akhir, dan nilai `@signature-params` sama
# persis dengan anggota `sig1` di header Signature-Input. Satu spasi yang berbeda sudah cukup untuk
# ditolak, jadi base ditulis dengan printf ke berkas — bukan lewat substitusi perintah, yang diam-diam
# membuang baris baru di ujung.
#
# `Content-Digest` selalu dikirim, juga untuk GET tanpa isi: kontrak mewajibkannya, dan nilainya lalu
# SHA-256 dari string kosong.
panggil_bertanda() {
    local metode="$1" jalur="$2" isi="$3" jawaban="$4" kunci="${5:-$KUNCI_SITUS}"
    local digest dibuat parameter dasar tanda batas kode

    digest="sha-256=:$(openssl dgst -sha256 -binary "$isi" | base64 -w0):"
    dibuat="$(date +%s)"
    parameter="(\"@method\" \"@path\" \"content-digest\");created=$dibuat;keyid=\"$SITUS_ID\";alg=\"rsa-v1_5-sha256\""
    dasar="$SEMENTARA/dasar-tanda-tangan.$BASHPID"

    printf '"@method": %s\n"@path": %s\n"content-digest": %s\n"@signature-params": %s' \
        "$metode" "$jalur" "$digest" "$parameter" > "$dasar"

    tanda="$(openssl dgst -sha256 -sign "$kunci" "$dasar" | base64 -w0)"

    # Unduhan berkas rilis boleh lebih lama dari panggilan biasa; sisanya dibatasi pendek supaya satu
    # admin.erp yang lambat tidak menahan putaran berikutnya.
    batas=60
    [ "$metode" != GET ] || batas=900

    local argumen=(
        --silent --show-error
        --proto '=https,http'
        --connect-timeout 15 --max-time "$batas"
        --output "$jawaban" --write-out '%{http_code}'
        --request "$metode"
        --header "Content-Digest: $digest"
        --header "Signature-Input: sig1=$parameter"
        --header "Signature: sig1=:$tanda:"
        --header 'Accept: application/json'
        --header "User-Agent: coreerp-agent/$AGEN_VERSI"
    )

    if [ "$metode" != GET ]; then
        argumen+=(--header 'Content-Type: application/json' --data-binary "@$isi")
    fi

    kode="$(curl "${argumen[@]}" "$SITUS_ADMIN$jalur" 2>>"$SEMENTARA/curl-galat")" || kode='000'
    printf '%s' "${kode:-000}"
}

# Pembungkus panggil_bertanda yang memulihkan rotasi kunci yang jawabannya hilang.
#
# Bila admin.erp sudah mengganti kunci tetapi jawaban 200-nya tidak pernah sampai — sambungan putus di
# detik yang salah — agen masih memegang kunci lama yang sudah ditolak, dan tanpa pemulihan ini situs
# terkunci keluar sampai seseorang datang ke server. Kunci baru yang belum pasti diterima disimpan
# sebagai "tertunda"; penolakan 401 dengan kunci lama dicoba sekali lagi dengan kunci itu.
panggil() {
    local kode kode_tertunda

    kode="$(panggil_bertanda "$@")"

    if [ "$kode" = 401 ] && [ -f "$KUNCI_TERTUNDA" ]; then
        kode_tertunda="$(panggil_bertanda "$1" "$2" "$3" "$4" "$KUNCI_TERTUNDA")"

        if [ "$kode_tertunda" != 401 ] && [ "$kode_tertunda" != 000 ]; then
            mv -f "$KUNCI_TERTUNDA" "$KUNCI_SITUS"
            openssl pkey -in "$KUNCI_SITUS" -pubout -out "$KUNCI_SITUS_PUBLIK.baru" 2>/dev/null
            mv -f "$KUNCI_SITUS_PUBLIK.baru" "$KUNCI_SITUS_PUBLIK"
            catat 'Kunci situs tertunda ternyata sudah diterima admin.erp; kunci itu kini dipakai.'
            kode="$kode_tertunda"
        fi
    fi

    printf '%s' "$kode"
}

# --- Laporan --------------------------------------------------------------------------------------------

# Keadaan container dibaca lewat Compose dengan nama proyek saja. Dijalankan dari `/` supaya berkas
# compose yang kebetulan ada di folder kerja tidak ikut menyempitkan daftarnya. Keluaran `ps --format
# json` berbeda antarversi — larik JSON pada Compose lama, satu objek per baris pada yang baru — dan
# keduanya diterima.
#
# Bila Compose tidak dapat dibaca, kunci `containers` **tidak dikirim**, bukan dikirim kosong. Larik
# kosong berarti "tidak ada container", dan itu klaim yang tidak diketahui kebenarannya.
baca_kontainer() {
    local tujuan="$1" mentah="$SEMENTARA/ps.json"

    if (cd / && docker compose --project-name "$PROYEK" ps --all --format json) > "$mentah" 2>/dev/null \
        && jq -cs '
            [ .[] | if type == "array" then .[] else . end | select(type == "object") ]
            | map({
                service: ((.Service // "") | tostring | .[0:60]),
                state: ((.State // "") | tostring | .[0:30]),
                health: (if ((.Health // "") | tostring) == "" then null else (.Health | tostring | .[0:30]) end)
              })
            | .[0:20]' "$mentah" > "$tujuan" 2>/dev/null; then
        return 0
    fi

    printf 'null' > "$tujuan"
}

ruang_bebas() {
    local jalur="$1"

    [ -n "$jalur" ] || return 0

    while [ ! -e "$jalur" ] && [ "$jalur" != / ] && [ "$jalur" != . ]; do
        jalur="$(dirname "$jalur")"
    done

    df -B1 --output=avail "$jalur" 2>/dev/null | tail -n 1 | tr -d '[:space:]' || true
}

folder_data() {
    # Sama dengan `update.sh`: data PostgreSQL on-prem lazim di-bind-mount ke disk tersendiri, dan pada
    # bentuk itu folder data Docker tidak memberi tahu apa pun tentang disk yang sebenarnya.
    if [ -n "${COREERP_TITIK_DATA_DB:-}" ]; then
        printf '%s' "$COREERP_TITIK_DATA_DB"
        return 0
    fi

    docker info --format '{{.DockerRootDir}}' 2>/dev/null || true
}

tanggal_habis_lisensi() {
    local berkas="$FOLDER_LISENSI/license.json" nilai

    [ -f "$berkas" ] || return 0

    nilai="$(jq -r '.valid_until // "" | tostring' "$berkas" 2>/dev/null || true)"
    nilai="${nilai:0:10}"

    if cocok "$nilai" '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
        printf '%s' "$nilai"
    fi
}

# Mencetak `true`, `false`, atau `null` — nilai JSON `license_required` di laporan.
#
# Root di server klien dapat mematikan kunci lisensi dengan satu baris `.env`, dan agen tidak dapat
# mencegahnya. Yang dapat dilakukan agen: melaporkan apa yang akan dilihat Core, supaya admin.erp tahu.
#
# Yang dibaca `.env` yang sama dengan yang diberikan update.sh ke Compose. Compose memakai baris terakhir
# untuk kunci yang disebut dua kali, jadi baris terakhir yang menentukan — `=false` yang ditambahkan di
# bawah `=true` tetap berarti mati. `true` hanya untuk bentuk yang persis; kutip, spasi, komentar di ujung,
# atau `export` dilaporkan `false`. Keliru ke arah itu hanya menyalakan peringatan yang lalu diperiksa
# orang; keliru ke arah sebaliknya menyembunyikan kunci yang dimatikan.
lisensi_diwajibkan() {
    local baris status=0

    baris="$(grep -E '^[[:space:]]*(export[[:space:]]+)?COREERP_LICENSE_REQUIRED[[:space:]]*=' "$BERKAS_ENV" 2>/dev/null \
        | tail -n 1)" || status=$?

    case "$status" in
        0) ;;
        # Kuncinya tidak disebut: Compose memakai bawaan false.
        1) printf 'false'; return 0 ;;
        # Berkasnya tidak ada atau tidak terbaca. Yang tidak diketahui tidak dilaporkan sebagai false.
        *) printf 'null'; return 0 ;;
    esac

    if [ "$baris" = 'COREERP_LICENSE_REQUIRED=true' ]; then
        printf 'true'
    else
        printf 'false'
    fi
}

# Setiap kunci laporan disebut satu per satu. Tidak ada `+ $keadaan` atau salinan utuh dari berkas
# lain: kunci baru di state.json tidak boleh ikut keluar hanya karena seseorang menambahkannya di sana.
susun_laporan() {
    local tujuan="$1" sekarang kontainer data cadangan lisensi wajib

    sekarang="$(sekarang_utc)"
    kontainer="$SEMENTARA/kontainer.json"
    baca_kontainer "$kontainer"

    data="$(ruang_bebas "$(folder_data)")"
    cadangan="$(ruang_bebas "$FOLDER_CADANGAN")"
    lisensi="$(tanggal_habis_lisensi)"
    wajib="$(lisensi_diwajibkan)"

    jq -c -n \
        --arg site_id "$SITUS_ID" \
        --arg versi "$AGEN_VERSI" \
        --arg sekarang "$sekarang" \
        --arg data "$data" \
        --arg cadangan "$cadangan" \
        --arg lisensi "$lisensi" \
        --argjson wajib "$wajib" \
        --slurpfile keadaan "$BERKAS_KEADAAN" \
        --slurpfile kontainer "$kontainer" '
        def angka($s): if ($s | test("^[0-9]+$")) then ($s | tonumber) else null end;
        def teks($s): if ($s | type) == "string" and $s != "" then $s else null end;
        ($keadaan[0] // {}) as $k
        | {
            site_id: $site_id,
            agent_version: $versi,
            created_at: $sekarang,
            server_time: $sekarang,
            edition: teks($k.edition),
            release: teks($k.release),
            image: teks($k.image),
            digest: teks($k.digest),
            containers: $kontainer[0],
            disk: {data_free_bytes: angka($data), backup_free_bytes: angka($cadangan)},
            last_backup: (
                if ($k.last_backup | type) == "object" then
                    {at: $k.last_backup.at, size_bytes: ($k.last_backup.size_bytes // null), result: $k.last_backup.result}
                else null end
            ),
            last_operation: (
                if ($k.last_operation | type) == "object" then
                    {id: $k.last_operation.id, result: $k.last_operation.result, step: ($k.last_operation.step // null)}
                else null end
            ),
            certificate_expires_at: null,
            license_expires_at: teks($lisensi),
            license_required: $wajib
          }
        | if .containers == null then del(.containers) else . end' > "$tujuan"
}

# Perpanjangan lisensi datang di jawaban laporan saat jatuh tempo — tanpa penjadwal di server ini dan tanpa
# operator yang harus mengingatnya. Keluarannya hanya ke stderr: stdout kirim_laporan adalah kode HTTP.
#
# Gagal memasang tidak menggagalkan laporan maupun putaran. Lisensi yang terpasang tetap berlaku sampai
# tanggalnya, laporan berikutnya masih menyebut tanggal lama, dan admin.erp menyertakan lisensi lagi sesudah
# jedanya. Putaran yang berhenti di sini justru tidak lagi mengambil operasi yang dapat memperbaikinya.
pasang_lisensi_dari_laporan() {
    local jawaban="$1"

    jq -e 'type == "object" and has("license")' "$jawaban" >/dev/null 2>&1 || return 0

    if pasang_lisensi "$jawaban" '.license'; then
        catat "Lisensi dari admin.erp terpasang, berlaku sampai $(tanggal_habis_lisensi)."
    else
        catat "Lisensi dari admin.erp DITOLAK dan tidak dipasang: $ALASAN. Lisensi yang terpasang tidak diubah."
    fi
}

# Mencetak kode HTTP. Interval dari admin.erp disimpan di site.json dan dipakai sebagai jeda putaran;
# lisensi yang disertakan admin.erp dipasang.
kirim_laporan() {
    local isi="$SEMENTARA/laporan.json" jawaban="$SEMENTARA/laporan-jawaban.json" kode interval

    susun_laporan "$isi"
    kode="$(panggil POST /api/agent/v1/report "$isi" "$jawaban")"

    if [ "$kode" = 200 ]; then
        interval="$(jq -r '.interval_seconds // "" | tostring' "$jawaban" 2>/dev/null || true)"

        if cocok "$interval" '^[0-9]+$' && [ "$interval" -ge 10 ] && [ "$interval" -le 86400 ]; then
            # shellcheck disable=SC2016 # variabel jq
            ubah_json "$BERKAS_SITUS" --argjson i "$interval" '.interval_seconds = $i'
        fi

        # shellcheck disable=SC2016 # variabel jq
        ubah_keadaan --argjson t "$(date +%s)" '.last_report_epoch = $t'

        pasang_lisensi_dari_laporan "$jawaban"
    fi

    printf '%s' "$kode"
}

# --- Laporan langkah operasi ----------------------------------------------------------------------------

# lapor_langkah ID STATUS LANGKAH [PESAN_GAGAL]
# Pulang 0 bila dicatat, 3 bila admin.erp menjawab 409 (operasi bukan milik agen ini lagi), 1 selain itu.
lapor_langkah() {
    local id="$1" status="$2" langkah_teks="$3" pesan="${4:-}"
    local isi="$SEMENTARA/langkah.json" jawaban="$SEMENTARA/langkah-jawaban.json" kode

    # Dicatat sebelum dikirim: terminal pemasang tetap melihat langkahnya walaupun admin.erp sedang tidak
    # terjangkau.
    [ "$status" != running ] || catat_langkah_berjalan "$langkah_teks"

    jq -c -n --arg status "$status" --arg step "$langkah_teks" --arg pesan "$pesan" '
        {status: $status, step: $step[0:120]}
        + (if $status == "failed" then
              {failure_message: ((if $pesan == "" then "tanpa keterangan" else $pesan end)[0:4000])}
           else {} end)' > "$isi"

    kode="$(panggil POST "/api/agent/v1/operations/$id/steps" "$isi" "$jawaban")"

    case "$kode" in
        200) return 0 ;;
        409)
            catat "admin.erp menjawab 409 untuk operasi $id: operasi ini tidak lagi dipegang agen ini."
            return 3
            ;;
        *)
            catat "Laporan langkah operasi $id tidak tercatat (HTTP $kode)."
            return 1
            ;;
    esac
}

# Hasil akhir dicoba beberapa kali: tanpanya operasi yang sebenarnya selesai baru terlihat gagal ketika
# lease-nya habis, dan admin.erp tidak punya cara lain untuk mengetahui yang sebenarnya.
tutup_operasi() {
    local id="$1" status="$2" langkah_teks="$3" pesan="${4:-}" percobaan hasil

    catat_operasi_terakhir "$id" "$status" "$langkah_teks"
    [ "$OPERASI_JENIS" != install ] || catat_pemasangan_terakhir "$id" "$status" "$langkah_teks" "$pesan"

    for percobaan in 1 2 3; do
        hasil=0
        lapor_langkah "$id" "$status" "$langkah_teks" "$pesan" || hasil=$?

        case "$hasil" in
            0 | 3) return "$hasil" ;;
        esac

        [ "$percobaan" -eq 3 ] || sleep "$((percobaan * 2))"
    done

    return 1
}

# --- Rilis: unduh, periksa, jaga ------------------------------------------------------------------------

MANIFEST_EDISI=''
MANIFEST_RILIS=''
MANIFEST_IMAGE=''
MANIFEST_DIGEST=''

berkas_tercantum() {
    awk -v nama="$2" '{ n = $2; sub(/^\*/, "", n); if (n == nama) ada = 1 } END { exit !ada }' "$1"
}

# periksa_berkas_rilis FOLDER — pulang 1 dengan ALASAN bila ditolak; mengisi MANIFEST_* bila lulus.
#
# Urutannya sama dengan `update.sh`, dan untuk alasan yang sama: tanda tangan lebih dulu, karena
# checksum yang tidak ditandatangani dapat ikut diganti oleh orang yang mengganti isinya.
periksa_berkas_rilis() {
    local folder="$1" satu wajib

    for satu in manifest.json compose.yaml update.sh SHA256SUMS SHA256SUMS.sig; do
        [ -f "$folder/$satu" ] || { tolak "berkas rilis tidak lengkap: $satu tidak ada"; return 1; }
    done

    [ -f "$KUNCI_RILIS" ] || { tolak "kunci publik rilis tidak ada di $KUNCI_RILIS"; return 1; }

    if ! openssl dgst -sha256 -verify "$KUNCI_RILIS" \
        -signature "$folder/SHA256SUMS.sig" "$folder/SHA256SUMS" >/dev/null 2>&1; then
        tolak 'tanda tangan SHA256SUMS TIDAK sah; rilis ini bukan yang kami terbitkan, atau berubah sesudah ditandatangani'
        return 1
    fi

    # `sha256sum --check` hanya memeriksa berkas yang tercantum. Berkas yang tidak tercantum lolos tanpa
    # diperiksa sama sekali.
    wajib=(manifest.json compose.yaml update.sh)

    for satu in "${wajib[@]}"; do
        berkas_tercantum "$folder/SHA256SUMS" "$satu" \
            || { tolak "$satu tidak tercantum di SHA256SUMS yang ditandatangani"; return 1; }
    done

    if ! (cd "$folder" && sha256sum --quiet --strict --check SHA256SUMS) >/dev/null 2>&1; then
        tolak 'checksum berkas rilis tidak cocok dengan SHA256SUMS; salinannya rusak atau diubah'
        return 1
    fi

    jq -e 'type == "object"' "$folder/manifest.json" >/dev/null 2>&1 \
        || { tolak 'manifest.json bukan objek JSON'; return 1; }

    MANIFEST_EDISI="$(jq -r '.edisi // "" | tostring' "$folder/manifest.json")"
    MANIFEST_RILIS="$(jq -r '.rilis // "" | tostring' "$folder/manifest.json")"
    MANIFEST_IMAGE="$(jq -r '.image // "" | tostring' "$folder/manifest.json")"
    MANIFEST_DIGEST="$(jq -r '.digest // "" | tostring' "$folder/manifest.json")"

    edisi_sah "$MANIFEST_EDISI" || { tolak 'manifest menyebut edisi yang tidak sah'; return 1; }
    rilis_sah "$MANIFEST_RILIS" || { tolak 'manifest menyebut nomor rilis yang tidak sah'; return 1; }
    [ -n "$MANIFEST_IMAGE" ] || { tolak 'manifest tidak menyebut image'; return 1; }
}

# izinkan_rilis EDISI RILIS — pulang 1 dengan ALASAN bila rilis ini tidak boleh dipasang di sini.
izinkan_rilis() {
    local edisi="$1" rilis="$2" edisi_terpasang rilis_terpasang

    edisi_terpasang="$(jq -r '.edition // "" | tostring' "$BERKAS_KEADAAN")"
    rilis_terpasang="$(jq -r '.release // "" | tostring' "$BERKAS_KEADAAN")"

    if [ -n "$edisi_terpasang" ] && [ "$edisi" != "$edisi_terpasang" ]; then
        tolak "edisi $edisi berbeda dari edisi terpasang $edisi_terpasang; agen tidak mengganti edisi"
        return 1
    fi

    if [ -n "$rilis_terpasang" ] && ! rilis_lebih_baru "$rilis" "$rilis_terpasang"; then
        tolak "rilis $rilis tidak lebih baru dari rilis terpasang $rilis_terpasang; agen tidak memasang rilis yang sama atau lebih lama"
        return 1
    fi
}

catat_rilis_terpasang() {
    # shellcheck disable=SC2016 # variabel jq
    ubah_keadaan \
        --arg e "$MANIFEST_EDISI" --arg r "$MANIFEST_RILIS" --arg i "$MANIFEST_IMAGE" --arg d "$MANIFEST_DIGEST" \
        '.edition = $e | .release = $r
         | .image = (if $i == "" then null else $i end)
         | .digest = (if $d == "" then null else $d end)'
}

# ikuti_keluaran ID_OPERASI BERKAS_LOG BERKAS_PENANDA_LEPAS
#
# Membaca keluaran update.sh baris demi baris: menyalinnya ke log dan ke keluaran agen, dan melaporkan
# setiap baris `==> ` sebagai langkah. Berjalan di ujung pipa, jadi keadaannya dititipkan ke berkas.
#
# Sesudah admin.erp menjawab 409, pelaporan berhenti tetapi **pembacaan tidak**, dan update.sh tidak
# dibunuh. Berhenti membaca membuat update.sh mati kena SIGPIPE pada tulisan berikutnya — sama saja
# dengan membunuhnya — dan membunuhnya di tengah migrasi meninggalkan database setengah bermigrasi tanpa
# ada yang menjalankan jalur mundurnya. update.sh sendiri yang tahu cara mundur dengan selamat; operasi
# yang sudah bukan milik kita lebih baik dibiarkan selesai daripada dihentikan di titik paling berbahaya.
ikuti_keluaran() {
    local id="$1" log="$2" penanda="$3" baris sisa='' kode_baca langkah_kini='' terakhir_lapor hasil batas_baca=30

    terakhir_lapor="$(date +%s)"
    [ "$DETAK_DETIK" -ge "$batas_baca" ] || batas_baca="$DETAK_DETIK"

    while :; do
        kode_baca=0
        IFS= read -r -t "$batas_baca" baris || kode_baca=$?

        if [ "$kode_baca" -gt 128 ]; then
            # Waktu baca habis. Potongan baris yang belum lengkap disimpan, dan lease diperpanjang bila
            # langkah ini sudah lama berjalan tanpa keluaran.
            sisa="$sisa$baris"

            if [ -n "$id" ] && [ -n "$langkah_kini" ] && [ ! -e "$penanda" ] \
                && [ "$(( $(date +%s) - terakhir_lapor ))" -ge "$DETAK_DETIK" ]; then
                hasil=0
                lapor_langkah "$id" running "$langkah_kini" || hasil=$?
                [ "$hasil" -ne 3 ] || : > "$penanda"
                terakhir_lapor="$(date +%s)"
            fi

            continue
        fi

        baris="$sisa$baris"
        sisa=''

        if [ "$kode_baca" -ne 0 ] && [ -z "$baris" ]; then
            break
        fi

        baris="${baris%$'\r'}"
        printf '%s\n' "$baris" >> "$log"
        printf '%s\n' "$baris"

        case "$baris" in
            '==> '*)
                langkah_kini="${baris#==> }"
                printf '%s' "$langkah_kini" > "$SEMENTARA/langkah-kini"

                if [ -n "$id" ] && [ ! -e "$penanda" ]; then
                    hasil=0
                    lapor_langkah "$id" running "$langkah_kini" || hasil=$?
                    [ "$hasil" -ne 3 ] || : > "$penanda"
                    terakhir_lapor="$(date +%s)"
                fi
                ;;
        esac

        [ "$kode_baca" -eq 0 ] || break
    done
}

STATUS_PEMBARUAN=0
PEMBARUAN_DILEPAS=0

# jalankan_pembaruan FOLDER ID_OPERASI BERKAS_LOG — mengisi STATUS_PEMBARUAN dengan kode keluar
# update.sh, dan PEMBARUAN_DILEPAS=1 bila admin.erp melepas operasinya di tengah jalan.
jalankan_pembaruan() {
    local folder="$1" id="$2" log="$3" skrip penanda status_pipa

    # Seam pengujian: update.sh sungguhan menuntut Docker yang benar-benar menjalankan container.
    skrip="${COREERP_UPDATE_SCRIPT:-$folder/update.sh}"
    penanda="$SEMENTARA/operasi-lepas"
    rm -f "$penanda" "$SEMENTARA/langkah-kini"

    # fd 9 memegang kunci putaran. Ia ditutup untuk update.sh supaya proses yang mungkin ditinggalkannya
    # berjalan tidak ikut menahan kunci itu sesudah agen selesai.
    set +e
    bash "$skrip" "$folder" </dev/null 9>&- 2>&1 | ikuti_keluaran "$id" "$log" "$penanda"
    status_pipa=("${PIPESTATUS[@]}")
    set -e

    STATUS_PEMBARUAN="${status_pipa[0]}"
    PEMBARUAN_DILEPAS=0
    [ ! -e "$penanda" ] || PEMBARUAN_DILEPAS=1

    if [ "$STATUS_PEMBARUAN" -eq 0 ]; then
        # Dicatat walaupun operasinya sudah dilepas admin.erp: state.json harus menyebut apa yang
        # benar-benar terpasang. Laporan berikutnya dan penolakan mundur bergantung padanya.
        catat_rilis_terpasang
    fi
}

langkah_terakhir() {
    if [ -f "$SEMENTARA/langkah-kini" ]; then
        cat "$SEMENTARA/langkah-kini"
    fi
}

pesan_dari_log() {
    # Dua puluh baris terakhir keluaran update.sh — cukup untuk melihat sebabnya, dan tidak memuat
    # lingkungan proses. update.sh sendiri tidak pernah mencetak setelan rahasia.
    tail -n 20 "$1" 2>/dev/null | tr -d '\r' || true
}

PARAMETER_EDISI=''
PARAMETER_RILIS=''

# baca_parameter_rilis BERKAS_OPERASI — mengisi PARAMETER_EDISI dan PARAMETER_RILIS; pulang 1 dengan ALASAN.
#
# `upgrade` dan `install` menyebut rilisnya dengan cara yang sama, karena keduanya mengambil rilis lewat
# jalur yang sama (`pasang_rilis`). `release` yang null atau kosong ditolak di sini: admin.erp tidak pernah
# memberikan install tanpa rilis, dan agen tidak bergantung pada janji itu.
baca_parameter_rilis() {
    local berkas="$1"

    PARAMETER_EDISI="$(jq -r 'if (.parameters.edition | type) == "string" then .parameters.edition else "" end' "$berkas")"
    PARAMETER_RILIS="$(jq -r 'if (.parameters.release | type) == "string" then .parameters.release else "" end' "$berkas")"

    if ! edisi_sah "$PARAMETER_EDISI" || ! rilis_sah "$PARAMETER_RILIS"; then
        tolak 'edition dan release wajib ada dan berbentuk benar'
        return 1
    fi
}

HASIL_RILIS=''
LOG_OPERASI=''

# pasang_rilis ID EDISI RILIS LANGKAH_TOLAK — mengunduh, memeriksa, lalu menjalankan update.sh atas satu
# rilis. Satu-satunya jalur rilis masuk ke server ini, dipakai `upgrade` dan `install`: penarikan image dari
# registry sendiri (AG-01 di docs/todo/registry-harbor) menggantinya di sini, untuk keduanya sekaligus.
#
# Hasilnya di HASIL_RILIS, bukan di kode keluar:
#
#   terpasang   update.sh selesai; operasinya BELUM ditutup, pemanggil yang menutupnya
#   ditutup     gagal, dan kegagalannya sudah dilaporkan
#   dilepas     admin.erp melepas operasinya; tidak ada yang dilaporkan lagi
#
# Kode keluar tidak dipakai karena pemanggil yang menangkapnya dengan `||` diam-diam mematikan `set -e` untuk
# seluruh isi fungsi ini. LOG_OPERASI menyebut log operasi yang ditulis update.sh.
pasang_rilis() {
    local id="$1" edisi="$2" rilis="$3" langkah_tolak="$4" sementara tujuan satu kode hasil log hasil_lokal

    HASIL_RILIS=ditutup
    log="$FOLDER_LOG/operasi-$id.log"
    LOG_OPERASI="$log"

    # Pemeriksaan pertama memakai nomor yang diminta, supaya penolakan yang jelas tidak perlu mengunduh
    # apa pun. Pemeriksaan yang menentukan ada di bawah, pada manifest yang ditandatangani.
    if ! izinkan_rilis "$edisi" "$rilis"; then
        tutup_operasi "$id" failed "$langkah_tolak" "$ALASAN"
        return
    fi

    hasil=0
    lapor_langkah "$id" running "Mengunduh dan memeriksa rilis $rilis" || hasil=$?

    if [ "$hasil" -eq 3 ]; then
        HASIL_RILIS=dilepas
        return
    fi

    sementara="$(mktemp -d "$FOLDER_RILIS/.unduh.XXXXXX")"

    for satu in manifest.json compose.yaml update.sh SHA256SUMS SHA256SUMS.sig; do
        kode="$(panggil GET "/api/agent/v1/releases/$edisi/$rilis/files/$satu" "$SEMENTARA/kosong" "$sementara/$satu")"

        if [ "$kode" != 200 ]; then
            rm -rf "$sementara"
            tutup_operasi "$id" failed "Mengunduh rilis $rilis" "mengunduh $satu gagal (HTTP $kode)"
            return
        fi
    done

    if ! periksa_berkas_rilis "$sementara"; then
        rm -rf "$sementara"
        tutup_operasi "$id" failed "Memeriksa rilis $rilis" "$ALASAN"
        return
    fi

    # Nomor yang diminta dan nomor yang ditandatangani harus sama. Tanpa ini, admin.erp yang dibobol dapat
    # meminta "9.9.9" lalu menyajikan berkas rilis lama yang sah di bawah nama itu.
    if [ "$MANIFEST_EDISI" != "$edisi" ] \
        || [ "$(normalkan_rilis "$MANIFEST_RILIS")" != "$(normalkan_rilis "$rilis")" ]; then
        rm -rf "$sementara"
        tutup_operasi "$id" failed "Memeriksa rilis $rilis" \
            "manifest yang ditandatangani menyebut $MANIFEST_EDISI $MANIFEST_RILIS, bukan $edisi $rilis yang diminta"
        return
    fi

    if ! izinkan_rilis "$MANIFEST_EDISI" "$MANIFEST_RILIS"; then
        rm -rf "$sementara"
        tutup_operasi "$id" failed "$langkah_tolak" "$ALASAN"
        return
    fi

    tujuan="$FOLDER_RILIS/$edisi-$rilis"
    rm -rf "$tujuan"
    mv "$sementara" "$tujuan"

    : > "$log"

    jalankan_pembaruan "$tujuan" "$id" "$log"

    if [ "$PEMBARUAN_DILEPAS" -eq 1 ]; then
        hasil_lokal=failed
        [ "$STATUS_PEMBARUAN" -ne 0 ] || hasil_lokal=succeeded
        catat_operasi_terakhir "$id" "$hasil_lokal" "$(langkah_terakhir)"
        catat 'Operasi dilepas admin.erp di tengah pembaruan; update.sh dibiarkan selesai dan hasilnya tidak dilaporkan.'
        HASIL_RILIS=dilepas
        return
    fi

    if [ "$STATUS_PEMBARUAN" -ne 0 ]; then
        tutup_operasi "$id" failed "$(langkah_terakhir)" "$(pesan_dari_log "$log")"
        return
    fi

    HASIL_RILIS=terpasang
}

operasi_upgrade() {
    local id="$1" berkas="$2"

    if ! baca_parameter_rilis "$berkas"; then
        tutup_operasi "$id" failed 'Menolak pembaruan' "parameter upgrade tidak sah: $ALASAN"
        return
    fi

    catat_rilis_berjalan "$PARAMETER_RILIS"
    pasang_rilis "$id" "$PARAMETER_EDISI" "$PARAMETER_RILIS" 'Menolak pembaruan'

    case "$HASIL_RILIS" in
        terpasang) tutup_operasi "$id" succeeded "Rilis $MANIFEST_RILIS terpasang" ;;
        dilepas) return 3 ;;
    esac
}

# --- Pemasangan pertama ---------------------------------------------------------------------------------

# periksa_parameter_pasang BERKAS_OPERASI — pulang 1 dengan ALASAN bila satu parameter `install` tidak sah.
#
# Semuanya diperiksa sebelum satu berkas pun diunduh: parameter yang baru ditolak Core sesudah rilisnya
# terpasang meninggalkan server yang menyala tanpa tenant, dan operasi yang gagal di langkah terakhir.
#
# Nilainya dibaca jq langsung dari berkas operasi, tidak pernah lewat `--arg`: argumen jq terbaca siapa pun
# dari daftar proses, dan salah satu nilainya hash kata sandi. Karena alasan yang sama tidak ada ALASAN yang
# menyebut nilai yang ditolak.
#
# Pola memakai `\A` dan `\z`, bukan `^` dan `$`: jq memakai Oniguruma, dan di sana `$` juga cocok sebelum baris
# baru di ujung.
periksa_parameter_pasang() {
    local berkas="$1" bidang

    baca_parameter_rilis "$berkas" || return 1

    # Aturan ULID yang sama dengan validasi `ulid` Laravel di Core: 26 huruf Crockford base32, huruf pertama
    # 0-7. Huruf kecil diterima; admin.erp menulis ULID dengan huruf kecil, dan Core menyamakannya.
    jq -e '(.parameters.tenant_id | type) == "string"
        and (.parameters.tenant_id | test("\\A[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}\\z"))' "$berkas" >/dev/null 2>&1 \
        || { tolak 'tenant_id bukan ULID (26 huruf Crockford base32)'; return 1; }

    # Nama sampai ke terminal dan log lewat keluaran Core; huruf kendali di sana dapat menyamarkan isi layar.
    # Batas 255 sama dengan batas Core, supaya yang ditolak Core ditolak di sini lebih dulu.
    for bidang in tenant_name admin_name; do
        # shellcheck disable=SC2016 # $b adalah variabel jq
        jq -e --arg b "$bidang" '(.parameters[$b] | type) == "string" and (.parameters[$b] | test("[^[:space:]]"))' \
            "$berkas" >/dev/null 2>&1 \
            || { tolak "$bidang wajib berupa teks yang tidak kosong"; return 1; }
        # shellcheck disable=SC2016 # $b adalah variabel jq
        jq -e --arg b "$bidang" '.parameters[$b] | length <= 255' "$berkas" >/dev/null 2>&1 \
            || { tolak "$bidang lebih dari 255 huruf"; return 1; }
        # shellcheck disable=SC2016 # $b adalah variabel jq
        jq -e --arg b "$bidang" '.parameters[$b] | test("[[:cntrl:]]") | not' "$berkas" >/dev/null 2>&1 \
            || { tolak "$bidang memuat huruf kendali"; return 1; }
    done

    jq -e '(.parameters.admin_email | type) == "string"
        and (.parameters.admin_email | test("\\A[^@[:space:][:cntrl:]]+@[^@[:space:][:cntrl:]]+\\z"))' "$berkas" >/dev/null 2>&1 \
        || { tolak 'admin_email bukan alamat email'; return 1; }
    jq -e '.parameters.admin_email | length <= 255' "$berkas" >/dev/null 2>&1 \
        || { tolak 'admin_email lebih dari 255 huruf'; return 1; }

    # Larik kosong sah: tenant yang hanya memakai Core. Setiap id menjadi satu `--app=<id>`; tanpa pola ini id
    # berawalan minus atau berisi baris baru ikut masuk ke argumen perintah Core.
    jq -e '(.parameters.app_ids | type) == "array"
        and all(.parameters.app_ids[]; type == "string" and test("\\A[a-z0-9][a-z0-9-]*\\z"))' "$berkas" >/dev/null 2>&1 \
        || { tolak 'app_ids bukan larik id app (huruf kecil, angka, dan tanda minus)'; return 1; }

    # admin.erp mengirim id yang unik. Core menolak id ganda — tetapi baru sesudah rilisnya terpasang.
    jq -e '(.parameters.app_ids | length) == (.parameters.app_ids | unique | length)' "$berkas" >/dev/null 2>&1 \
        || { tolak 'app_ids menyebut app yang sama lebih dari sekali'; return 1; }

    # Bentuk yang sama persis dengan yang diterima Core. `$2a$` dan `$2b$` tidak dikenali Laravel sebagai hash,
    # dan di-hash ulang sebagai teks polos: admin pertama tidak pernah dapat masuk.
    jq -e '(.parameters.admin_password_hash | type) == "string"
        and (.parameters.admin_password_hash | test("\\A\\$2y\\$(0[4-9]|[12][0-9]|3[01])\\$[./A-Za-z0-9]{53}\\z"))' \
        "$berkas" >/dev/null 2>&1 \
        || { tolak 'admin_password_hash bukan hash bcrypt berawalan 2y (isinya tidak dicetak)'; return 1; }
}

# Operasi `install`: rilis pertama, lalu tenant dengan id yang sama dengan admin.erp beserta admin pertamanya.
#
# **Hash kata sandi hanya lewat stdin.** Kata sandi sementara dibuat admin.erp dan ditunjukkan sekali kepada
# operator; yang sampai ke sini hanya hash bcrypt-nya. Hash itu tidak pernah menjadi argumen proses — terbaca
# dari daftar proses — dan tidak pernah ditulis ke log agen, log operasi, atau state.json. Keluaran Core
# disaring sebelum ditulis ke mana pun: Core tidak mencetaknya, tetapi log yang memuat hash tidak dapat
# ditarik kembali dari journald dan pengumpul log.
#
# **Aman diulang.** Rilis yang sama yang sudah terpasang tidak diunduh dan dijalankan ulang — penolakan rilis
# yang tidak lebih baru akan menggagalkan ulangan itu — dan Core menjawab tenant dengan owner yang sama
# "sudah ada" dengan kode keluar nol. "Coba lagi" sesudah langkah tenant gagal karena itu langsung mengulang
# langkah tenant.
#
# Jendela pembaruan tidak diperiksa di sini: admin.erp yang memutuskan kapan `install` boleh diklaim.
operasi_pasang() {
    local id="$1" berkas="$2" edisi rilis tenant_id tenant_nama nama_admin email_admin hash
    local compose_sehat versi_sehat image_sehat log baris_awal hasil satu
    local -a app=() perintah_core=() status_pipa=()

    if ! periksa_parameter_pasang "$berkas"; then
        tutup_operasi "$id" failed 'Menolak pemasangan' "parameter install tidak sah: $ALASAN"
        return
    fi

    edisi="$PARAMETER_EDISI"
    rilis="$PARAMETER_RILIS"
    tenant_id="$(jq -r '.parameters.tenant_id' "$berkas")"
    tenant_nama="$(jq -r '.parameters.tenant_name' "$berkas")"
    nama_admin="$(jq -r '.parameters.admin_name' "$berkas")"
    email_admin="$(jq -r '.parameters.admin_email' "$berkas")"
    mapfile -t app < <(jq -r '.parameters.app_ids[]' "$berkas")
    hash="$(jq -r '.parameters.admin_password_hash' "$berkas")"

    catat_rilis_berjalan "$rilis"

    if [ "$(jq -r '.edition // "" | tostring' "$BERKAS_KEADAAN")" = "$edisi" ] \
        && [ "$(normalkan_rilis "$(jq -r '.release // "" | tostring' "$BERKAS_KEADAAN")")" = "$(normalkan_rilis "$rilis")" ]; then
        log="$FOLDER_LOG/operasi-$id.log"
        : > "$log"

        hasil=0
        lapor_langkah "$id" running "Rilis $rilis sudah terpasang; pembaruan dilewati" || hasil=$?
        [ "$hasil" -ne 3 ] || return 3
    else
        pasang_rilis "$id" "$edisi" "$rilis" 'Menolak pemasangan'

        case "$HASIL_RILIS" in
            terpasang) ;;
            dilepas) return 3 ;;
            *) return ;;
        esac

        log="$LOG_OPERASI"
    fi

    hasil=0
    lapor_langkah "$id" running 'Melahirkan tenant dan admin pertama' || hasil=$?
    [ "$hasil" -ne 3 ] || return 3

    # Compose dan image yang dicatat update.sh sesudah terbukti sehat — yang sama dengan yang dipakai
    # bootstrap-tenant dan cadangan.
    compose_sehat="$FOLDER_KEADAAN_UPDATE/compose-sehat.yaml"
    versi_sehat="$FOLDER_KEADAAN_UPDATE/versi-sehat"
    image_sehat=''
    [ ! -f "$versi_sehat" ] || image_sehat="$(cat "$versi_sehat")"

    if [ -z "$image_sehat" ] || [ ! -f "$compose_sehat" ] || [ ! -f "$BERKAS_ENV" ]; then
        tutup_operasi "$id" failed 'Melahirkan tenant dan admin pertama' \
            'belum ada versi yang terbukti sehat di server ini, atau .env tidak ada; tenant dilahirkan di dalam aplikasi yang sedang berjalan'
        return
    fi

    # Opsi ditulis `--opsi=nilai`, bukan `--opsi nilai`: nama yang kebetulan diawali tanda minus akan dibaca
    # Symfony Console sebagai opsi lain pada bentuk kedua.
    perintah_core=(
        docker compose --project-name "$PROYEK" --env-file "$BERKAS_ENV" -f "$compose_sehat"
        exec -T core-app php artisan tenant:bootstrap-site
        "--tenant-id=$tenant_id"
        "--name=$tenant_nama"
        "--admin-name=$nama_admin"
        "--admin-email=$email_admin"
        --admin-password-hash-stdin
    )

    for satu in "${app[@]}"; do
        perintah_core+=("--app=$satu")
    done

    baris_awal="$(wc -l < "$log")"

    # `printf` bawaan bash, bukan program: hash tidak muncul di argumen proses mana pun. Kode keluar yang
    # dipakai milik docker, bukan pipa: printf yang terlambat menulis ke Core yang sudah keluar mati kena
    # SIGPIPE walaupun Core-nya berhasil.
    set +e
    printf '%s' "$hash" \
        | EDITION_IMAGE="$image_sehat" "${perintah_core[@]}" 2>&1 9>&- \
        | while IFS= read -r satu || [ -n "$satu" ]; do
            satu="${satu%$'\r'}"
            satu="${satu//"$hash"/[hash disembunyikan]}"
            printf '%s\n' "$satu" >> "$log"
            printf '%s\n' "$satu"
        done
    status_pipa=("${PIPESTATUS[@]}")
    set -e

    if [ "${status_pipa[1]}" -ne 0 ]; then
        tutup_operasi "$id" failed 'Melahirkan tenant dan admin pertama' \
            "$(tail -n "+$((baris_awal + 1))" "$log" | tail -n 20 || true)"
        return
    fi

    tutup_operasi "$id" succeeded "Pemasangan selesai: rilis $rilis"
}

# --- Cadangan -------------------------------------------------------------------------------------------

operasi_backup() {
    local id="$1" hasil compose_sehat versi_sehat tujuan sebagian galat ukuran image_sehat

    hasil=0
    lapor_langkah "$id" running 'Mencadangkan database' || hasil=$?
    [ "$hasil" -ne 3 ] || return 3

    # Compose dan image yang dipakai adalah yang dicatat update.sh sesudah terbukti sehat — yang sama
    # dengan yang dipakainya untuk cadangan sebelum pembaruan. Tanpa keduanya belum ada database yang
    # pantas dicadangkan.
    compose_sehat="$FOLDER_KEADAAN_UPDATE/compose-sehat.yaml"
    versi_sehat="$FOLDER_KEADAAN_UPDATE/versi-sehat"
    galat="$SEMENTARA/pg_dump-galat"

    if [ ! -f "$compose_sehat" ] || [ ! -f "$versi_sehat" ]; then
        # shellcheck disable=SC2016 # variabel jq
        ubah_keadaan --arg at "$(sekarang_utc)" '.last_backup = {at: $at, size_bytes: null, result: "failed"}'
        tutup_operasi "$id" failed 'Mencadangkan database' \
            'belum ada versi yang terbukti sehat di server ini; tidak ada database untuk dicadangkan'
        return
    fi

    mkdir -p "$FOLDER_CADANGAN"
    tujuan="$FOLDER_CADANGAN/terjadwal-$(cap_waktu).dump"
    sebagian="$tujuan.sebagian"
    image_sehat="$(cat "$versi_sehat")"

    # Ditulis ke nama sementara lalu diganti namanya: dump yang terpotong karena disk penuh tidak boleh
    # terlihat sama dengan cadangan yang utuh. Isinya data pasien, jadi hanya root yang dapat membacanya.
    hasil=0
    (
        umask 077
        EDITION_IMAGE="$image_sehat" docker compose --project-name "$PROYEK" \
            --env-file "$BERKAS_ENV" -f "$compose_sehat" \
            exec -T core-db pg_dump -U core_erp -d core_erp -Fc > "$sebagian" 2> "$galat" 9>&-
    ) || hasil=$?

    if [ "$hasil" -ne 0 ] || [ ! -s "$sebagian" ]; then
        rm -f "$sebagian"
        # shellcheck disable=SC2016 # variabel jq
        ubah_keadaan --arg at "$(sekarang_utc)" '.last_backup = {at: $at, size_bytes: null, result: "failed"}'
        tutup_operasi "$id" failed 'Mencadangkan database' \
            "pg_dump gagal: $(tail -n 20 "$galat" 2>/dev/null || true)"
        return
    fi

    mv -f "$sebagian" "$tujuan"
    ukuran="$(stat -c '%s' "$tujuan")"

    # shellcheck disable=SC2016 # variabel jq
    ubah_keadaan --arg at "$(sekarang_utc)" --argjson ukuran "$ukuran" \
        '.last_backup = {at: $at, size_bytes: $ukuran, result: "succeeded"}'

    printf 'Cadangan: %s (%s bita)\n' "$tujuan" "$ukuran"
    tutup_operasi "$id" succeeded 'Cadangan database selesai'
}

# --- Lisensi --------------------------------------------------------------------------------------------

# ambil_lisensi BERKAS_JSON FILTER — memisahkan {license, signature} pada FILTER menjadi
# $SEMENTARA/lisensi.json (byte persis yang ditandatangani) dan $SEMENTARA/lisensi.sig (biner).
ambil_lisensi() {
    local sumber="$1" filter="$2"

    rm -f "$SEMENTARA/lisensi.json" "$SEMENTARA/lisensi.sig"

    if ! jq -j "$filter | if (.license | type) == \"string\" then .license else error(\"license\") end" \
        "$sumber" > "$SEMENTARA/lisensi.json" 2>/dev/null; then
        tolak 'license wajib berupa string JSON yang ditandatangani'
        return 1
    fi

    if ! jq -r "$filter | if (.signature | type) == \"string\" then .signature else error(\"signature\") end" \
        "$sumber" 2>/dev/null | base64 -d > "$SEMENTARA/lisensi.sig" 2>/dev/null \
        || [ ! -s "$SEMENTARA/lisensi.sig" ]; then
        tolak 'signature wajib berupa base64 yang sah'
        return 1
    fi
}

# pasang_lisensi BERKAS_JSON FILTER — pulang 1 dengan ALASAN bila ditolak.
#
# Satu-satunya jalan lisensi masuk ke folder lisensi. Operasi `install_license` dan jawaban laporan
# sama-sama memanggilnya, supaya perpanjangan otomatis — yang tidak dilihat siapa pun — tidak pernah
# diperiksa lebih longgar daripada pemasangan yang diminta operator.
#
# Lisensi versi 2 **mengunci**. Core yang mewajibkan lisensi hanya membuka app yang disebut `apps`, dan
# lisensi yang tidak dapat dibacanya mengunci seluruh tenant. Karena itu semua pemeriksaan selesai sebelum
# lisensi yang terpasang disentuh: lisensi yang akan ditolak Core tidak boleh menggantikan lisensi yang
# masih diterimanya. Yang ditolak di sini, lisensi lama tetap berlaku sampai tanggalnya sendiri.
#
# Kunci pemeriksanya kunci lisensi yang diantar admin.erp saat pendaftaran, bukan kunci rilis. admin.erp
# memang sumber kebenaran app yang dibeli; lisensi menentukan app yang boleh dibuka, tetapi tidak dapat
# mengganti kode yang berjalan. Yang dijaga di sini lisensi yang rusak di jalan, lisensi milik situs lain,
# dan bentuk yang tidak dibaca Core.
pasang_lisensi() {
    local sumber="$1" filter="$2" kunci="$FOLDER_LISENSI/license-public.pem" situs_lisensi berlaku
    local lisensi="$SEMENTARA/lisensi.json" tanda="$SEMENTARA/lisensi.sig"
    local baru="$FOLDER_LISENSI/.license.json.baru" baru_tanda="$FOLDER_LISENSI/.license.json.sig.baru"

    ambil_lisensi "$sumber" "$filter" || return 1

    [ -f "$kunci" ] || { tolak "kunci publik lisensi belum dipasang ($kunci)"; return 1; }

    if ! openssl dgst -sha256 -verify "$kunci" -signature "$tanda" "$lisensi" >/dev/null 2>&1; then
        tolak 'tanda tangan lisensi TIDAK sah'
        return 1
    fi

    jq -e 'type == "object"' "$lisensi" >/dev/null 2>&1 || { tolak 'lisensi bukan objek JSON'; return 1; }

    # Situs yang tidak disebut ditolak seperti situs lain. Kunci publik lisensi sama untuk semua situs, jadi
    # lisensi tanpa situs dapat dipasang di server mana pun — termasuk lisensi tenant lain dengan app lebih
    # banyak.
    # shellcheck disable=SC2016 # $s adalah variabel jq
    if ! jq -e --arg s "$SITUS_ID" '.site_id == $s' "$lisensi" >/dev/null 2>&1; then
        situs_lisensi="$(jq -r 'if (.site_id | type) == "string" then .site_id[0:100] else "" end' "$lisensi")"

        if [ -z "$situs_lisensi" ]; then
            tolak 'lisensi tidak menyebut situs; lisensi tanpa situs tidak dipasang'
        else
            tolak "lisensi ini untuk situs $situs_lisensi, bukan situs ini"
        fi
        return 1
    fi

    # Core membaca tepat satu versi. Versi lain yang terpasang terbaca tidak sah, dan itu mengunci.
    jq -e '.version == 2' "$lisensi" >/dev/null 2>&1 \
        || { tolak 'lisensi bukan format versi 2; agen hanya memasang versi yang dibaca Core'; return 1; }

    # `\A` dan `\z`, bukan `^` dan `$`: jq memakai Oniguruma, dan di sana `$` juga cocok sebelum baris baru —
    # "human-resources\n" akan lolos sebagai id app.
    jq -e '(.apps | type) == "array"
        and all(.apps[]; type == "string" and test("\\A[a-z0-9][a-z0-9-]*\\z"))' "$lisensi" >/dev/null 2>&1 \
        || { tolak 'apps di lisensi bukan larik id app (huruf kecil, angka, dan tanda minus)'; return 1; }

    jq -e '(.valid_until | type) == "string" and (.valid_until | test("\\A[0-9]{4}-[0-9]{2}-[0-9]{2}\\z"))' \
        "$lisensi" >/dev/null 2>&1 \
        || { tolak 'valid_until di lisensi bukan tanggal berbentuk YYYY-MM-DD'; return 1; }

    # Bentuk yang benar belum tentu tanggal yang ada. Core menolak 2027-02-30, jadi agen juga.
    berlaku="$(jq -r '.valid_until' "$lisensi")"
    if [ "$(date -u -d "$berlaku" +%Y-%m-%d 2>/dev/null || true)" != "$berlaku" ]; then
        tolak "valid_until di lisensi bukan tanggal kalender: $berlaku"
        return 1
    fi

    # Byte lisensi disalin persis — tanda tangannya atas byte itu, dan Core memeriksanya lagi. Setiap tulisan
    # diperiksa sendiri: fungsi ini dipanggil dari dalam `if`, tempat `set -e` tidak menghentikan apa pun,
    # dan tanda tangan yang terpotong karena disk penuh lalu diganti namanya akan mengunci situs ini.
    if ! install -m 0644 "$lisensi" "$baru" \
        || ! base64 -w0 "$tanda" > "$baru_tanda" \
        || ! chmod 0644 "$baru_tanda"; then
        rm -f "$baru" "$baru_tanda"
        tolak "lisensi tidak dapat ditulis ke $FOLDER_LISENSI"
        return 1
    fi

    mv -f "$baru_tanda" "$FOLDER_LISENSI/license.json.sig"
    mv -f "$baru" "$FOLDER_LISENSI/license.json"
}

operasi_lisensi() {
    local id="$1" berkas="$2"

    if ! pasang_lisensi "$berkas" '.parameters'; then
        tutup_operasi "$id" failed 'Menolak lisensi' "$ALASAN"
        return
    fi

    tutup_operasi "$id" succeeded 'Lisensi terpasang'
}

# --- Rotasi kunci ---------------------------------------------------------------------------------------

operasi_putar_kunci() {
    local id="$1" hasil baru publik_baru isi jawaban kode

    hasil=0
    lapor_langkah "$id" running 'Membuat pasangan kunci baru' || hasil=$?
    [ "$hasil" -ne 3 ] || return 3

    baru="$FOLDER_AGEN/site-key.pem.baru"
    publik_baru="$FOLDER_AGEN/site-public.pem.baru"
    isi="$SEMENTARA/kunci.json"
    jawaban="$SEMENTARA/kunci-jawaban"

    buat_kunci "$baru" "$publik_baru"
    jq -c -n --rawfile kunci "$publik_baru" '{public_key: $kunci}' > "$isi"

    # Ditandatangani kunci LAMA, tanpa pembungkus pemulihan: yang dibuktikan permintaan ini justru bahwa
    # pemegang kunci lama yang meminta pergantian.
    kode="$(panggil_bertanda POST /api/agent/v1/key "$isi" "$jawaban" "$KUNCI_SITUS")"

    case "$kode" in
        200)
            # Kunci privat diganti lebih dulu. Bila mesin mati di antara dua penggantian nama, kunci
            # privat sudah cocok dengan yang dipegang admin.erp; kunci publik dapat diturunkan lagi
            # darinya, sementara kebalikannya tidak.
            mv -f "$baru" "$KUNCI_SITUS"
            mv -f "$publik_baru" "$KUNCI_SITUS_PUBLIK"
            rm -f "$KUNCI_TERTUNDA"
            catat 'Kunci situs diganti; kunci lama dibuang.'
            tutup_operasi "$id" succeeded 'Kunci situs diganti'
            ;;
        000)
            # Tidak ada jawaban: admin.erp mungkin sudah mengganti kuncinya, mungkin belum. Lihat `panggil`.
            mv -f "$baru" "$KUNCI_TERTUNDA"
            rm -f "$publik_baru"
            catat 'admin.erp tidak menjawab permintaan ganti kunci; kunci baru disimpan sebagai tertunda.'
            return 1
            ;;
        *)
            rm -f "$baru" "$publik_baru"
            tutup_operasi "$id" failed 'Mengganti kunci situs' "admin.erp menolak kunci baru (HTTP $kode)"
            ;;
    esac
}

operasi_diagnosa() {
    local id="$1" kode

    kode="$(kirim_laporan)"

    if [ "$kode" = 200 ]; then
        tutup_operasi "$id" succeeded 'Diagnosa terkirim'
    else
        tutup_operasi "$id" failed 'Mengirim diagnosa' "laporan tidak diterima admin.erp (HTTP $kode)"
    fi
}

kerjakan_operasi() {
    local berkas="$1" id operasi

    id="$(jq -r '.id // "" | tostring' "$berkas")"
    operasi="$(jq -r '.operation // "" | tostring' "$berkas")"

    if ! id_sah "$id"; then
        catat 'admin.erp menyerahkan operasi dengan id yang tidak sah; operasi tidak dikerjakan dan tidak dapat dilaporkan.'
        return 1
    fi

    catat "Mengerjakan operasi $id: ${operasi:0:40}"

    OPERASI_JENIS="${operasi:0:40}"
    catat_operasi_berjalan "$id" "$OPERASI_JENIS"

    case "$operasi" in
        upgrade) operasi_upgrade "$id" "$berkas" ;;
        install) operasi_pasang "$id" "$berkas" ;;
        backup) operasi_backup "$id" ;;
        install_license) operasi_lisensi "$id" "$berkas" ;;
        rotate_key) operasi_putar_kunci "$id" ;;
        send_diagnostics) operasi_diagnosa "$id" ;;
        *) tutup_operasi "$id" failed 'Menolak operasi' 'operasi tidak dikenal' ;;
    esac
}

