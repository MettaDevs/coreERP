{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "docs:dev"
      ],
      "cwd": "docs",
      "port": 5173
    },
    {
      "name": "core",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S",
        "127.0.0.1:8000",
        "-t",
        "public",
        "server.php"
      ],
      "cwd": "apps/core",
      "port": 8000
    },
    {
      "name": "control-plane",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S",
        "127.0.0.1:8001",
        "-t",
        "public",
        "server.php"
      ],
      "cwd": "apps/control-plane",
      "port": 8001
    }
  ]
}
