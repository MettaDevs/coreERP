{
    "name": "@coreerp-comparison/native-typescript",
    "private": true,
    "type": "module",
    "scripts": {
        "start:hono": "bun src/hono.ts",
        "start:elysia": "bun src/elysia.ts",
        "build": "bun build src/hono.ts src/elysia.ts --target=bun --outdir dist --minify",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "format": "prettier --config ../../../../apps/core/.prettierrc --write src test package.json tsconfig.json",
        "format:check": "prettier --config ../../../../apps/core/.prettierrc --check src test package.json tsconfig.json"
    },
    "dependencies": {
        "@orpc/openapi": "1.16.1",
        "@orpc/server": "1.16.1",
        "elysia": "1.4.30",
        "hono": "4.13.16",
        "postgres": "3.4.7",
        "ulid": "3.0.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "prettier": "3.9.5",
        "prettier-plugin-tailwindcss": "0.6.14",
        "tailwindcss": "4.3.2",
        "typescript": "5.9.3"
    }
}
