{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "coreerp/core",
    "type": "project",
    "description": "CoreERP core service.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../modules/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "apperp/contoh-a": "@dev",
        "apperp/contoh-b": "@dev",
        "apperp/human-resources": "@dev",
        "apperp/management-aset": "@dev",
        "dedoc/scramble": "^0.13.35",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/opentelemetry-auto-laravel": "^1.9",
        "open-telemetry/opentelemetry-auto-psr3": "^0.3.0",
        "open-telemetry/sdk": "^1.15",
        "php-http/guzzle7-adapter": "^1.1",
        "phpoffice/phpspreadsheet": "4.0",
        "phpoffice/phpword": "1.3",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "phpunit/phpunit": "^12.5.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\Apperp\\ManagementAset\\Tests\\": "../../modules/apperp/management-aset/tests/",
            "Modules\\Apperp\\HumanResources\\Tests\\": "../../modules/apperp/human-resources/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel",
            "pint --parallel ../../modules"
        ],
        "lint:check": [
            "pint --parallel --test",
            "pint --parallel --test ../../modules"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan install:features --ansi",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test:parallel": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --parallel --exclude-group serial"
        ],
        "test:serial": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --group serial"
        ],
        "test:fast": [
            "Composer\\Config::disableProcessTimeout",
            "@test:parallel",
            "@test:serial"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": [
                    "@php artisan install:features --ansi"
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test:parallel": "Seluruh test kecuali yang membuat database sungguhan, di semua core.",
        "test:serial": "Hanya test yang membuat dan membuang database PostgreSQL sungguhan. Wajib berurutan.",
        "test:fast": "Keduanya, berurutan: yang paralel dulu, lalu yang serial."
    }
}
