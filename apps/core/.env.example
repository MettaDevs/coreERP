APP_NAME=CoreERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=core_erp
DB_USERNAME=core_erp_app
DB_PASSWORD=

COREERP_PROVIDER_EMAIL=provider@coreerp.local
COREERP_PROVIDER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Must be a store every instance can see (database or redis). The scheduler's onOneServer lock lives here, so
# `file` or `array` would let number-sequences:recover run on every instance at once.
CACHE_STORE=database
COREERP_REGISTRATION_RATE_LIMIT=5
COREERP_TRUSTED_PROXIES=
COREERP_PASSWORD_BREACH_CHECK=true
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pengumpul OTLP untuk kesalahan sisi peramban. Kosong berarti mati.
#
# Alamat pangkalnya saja, tanpa jalur: kode menambahkan `/v1/logs` sendiri. Nilainya
# **disisipkan saat membangun**, bukan dibaca saat berjalan, jadi mengubahnya menuntut
# `npm run build` ulang — dan pemasangan on-prem yang tidak punya pengumpul cukup
# membiarkannya kosong supaya tidak ada satu pun permintaan yang ditembakkan.
#
# Pengumpulnya harus mengizinkan origin aplikasi pada `cors.allowed_origins`; tanpa itu
# peramban menahan setiap kiriman pada permintaan OPTIONS dan tidak ada catatan yang sampai.
VITE_OTEL_ENDPOINT=
# Nama layanan pada catatan yang terkirim. Bawaannya `coreerp-control-plane`.
VITE_OTEL_SERVICE_NAME=

# Laporan kesalahan yang mendatangi orang lewat satu channel Discord.
#
# Berkas log dan SigNoz hanya menjawab pertanyaan yang sudah diajukan — keduanya diam
# sempurna selama belum ada yang curiga dan membuka. Ini yang memberitahu.
#
# Kosong berarti mati, dan itulah bawaannya: channel Discord pada pemasangan on-prem
# bukan milik kita, dan tidak ada nilai wajar yang bisa ditebak untuknya.
#
# Webhook dibuat di Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# URL itu memuat tokennya sendiri, jadi perlakukan seperti kata sandi.
COREERP_DISCORD_WEBHOOK_URL=
# Alamat antarmuka SigNoz — yang dibuka manusia di peramban, bukan porta OTLP yang menerima
# kiriman. Dipakai untuk menaruh tautan "Buka di SigNoz" di dalam laporan, supaya yang
# terpotong di Discord bisa dibaca utuh tanpa mencari sendiri. Kosong berarti tanpa tautan.
COREERP_SIGNOZ_URL=
# Ditulis apa adanya di depan ringkasan: `@everyone`, `@here`, `<@id_orang>`, `<@&id_role>`,
# atau gabungannya. Menulis `@nama` biasa tidak menyebut siapa pun — Discord hanya mengenali
# bentuk berkurung itu. Id didapat dengan menyalakan Developer Mode lalu klik kanan -> Copy ID.
COREERP_DISCORD_MENTION=
# Detik minimal antara dua kiriman untuk kesalahan yang sama. Bukan penyempurnaan: satu
# database yang mati membuat setiap permintaan gagal, dan tanpa jeda yang sampai ke tim
# bukan peringatan melainkan alasan mematikan notifikasi channelnya. Nol mematikan jeda.
COREERP_DISCORD_JEDA_DETIK=60

# Masih dipakai, jangan dihapus.
#
# Module yang berjalan di dalam runtime ini tidak lagi menerima event lewat HTTP, jadi mudah
# mengira setelan ini ikut mati bersama COREERP_SERVICE_TOKEN dan kawan-kawannya. Ia tidak:
# kunci ini menandatangani event yang keluar ke app yang masih berjalan sebagai proses
# tersendiri, dan tanpanya `workflow-events:publish` berhenti mengirim tanpa satu pun
# kesalahan — antreannya hanya menumpuk diam-diam.
COREERP_APP_CONTEXT_SIGNING_KEY=
# Requests per minute per app+tenant on the internal number sequence API.
COREERP_INTERNAL_API_RATE_LIMIT=600

# Token bersama yang dipakai pusat admin untuk memerintah Core, mis. melahirkan tenant lewat
# POST /api/internal/v1/tenants. Kosong berarti pemasangan ini menolak setiap perintah pusat
# admin — bawaan yang benar untuk on-prem dan lingkungan lokal, yang memang tidak punya pusat
# admin. Isinya harus sama persis dengan yang dipegang apps/control-plane.
COREERP_CONTROL_PLANE_TOKEN=

# The test suite runs on real PostgreSQL in its own schema, because every lock clause the number sequence design
# depends on compiles to an empty string on SQLite. Create it once with: CREATE SCHEMA coreerp_test;
#
# This schema is only used by the serial runner. `php artisan test --parallel` gives every worker its own
# database, and there the database itself is the boundary, so the schema below is ignored. Parallel runs need the
# database user to hold CREATEDB: ALTER ROLE <user> CREATEDB;
DB_TEST_SCHEMA=coreerp_test

# Database test, dan ia WAJIB berbeda dari DB_DATABASE di atas.
#
# Selama keduanya sama, setiap jalur yang membuat koneksi test menunjuk schema `public` akan
# mengosongkan database kerja pengembang — dan itu sudah terjadi **tiga kali** pada 11–12 September
# 2026. Kegagalannya bisu: `DatabaseTruncation` mengecualikan tabel `migrations`, sehingga yang
# tertinggal adalah skema utuh berisi nol baris. Suite hijau, exit code nol, lalu stack lokal kosong
# beberapa menit kemudian tanpa satu pun petunjuk yang menghubungkan keduanya.
#
# Dua jalur sudah ditutup satu per satu — sakelar paralel tanpa token, dan penjaga di `TestCase` —
# tetapi keduanya menambal jalur, bukan akarnya. Akarnya: **database test dan database kerja adalah
# database yang sama.** Selama itu benar, jalur ketiga akan menabraknya lagi.
#
# Database terpisah menutup seluruh kelas kesalahan itu sekaligus: schema mana pun yang ditunjuk
# koneksi test, ia tidak lagi berada di database yang memuat data kerja.
#
#   createdb core_erp_test
#   psql -d core_erp_test -c "CREATE SCHEMA IF NOT EXISTS coreerp_test;"
DB_TEST_DATABASE=core_erp_test

# Domain dasar yang di bawahnya tiap lingkungan memperoleh alamatnya sendiri.
#
#   production : <tenant>.contoh.co.id
#   selain itu : <tenant>--<lingkungan>.<jenis>.contoh.co.id
#
# **Kosong berarti satu alamat untuk semua, dan itu bawaannya.** Selama ia kosong,
# middleware pemilih lingkungan tidak pernah menyala — bukan gagal, tidak menyala — dan
# on-prem beserta lingkungan lokal bekerja persis seperti sebelum ia ada.
#
# Isi `localhost` untuk mencobanya di mesin sendiri: peramban modern menyelesaikan setiap
# `*.localhost` ke mesin sendiri, jadi `pelanggan--uji.demo.localhost:8000` bekerja tanpa
# menyentuh DNS sama sekali.
COREERP_BASE_DOMAIN=

# Penyedia identitas bersama (OIDC). Kosong berarti tidak ada SSO, dan itu bawaannya.
#
# Ketiganya wajib terisi bersamaan. Alamat balik yang harus didaftarkan di penyedia SATU per
# penempatan, bukan satu per tenant — `<skema>://<COREERP_BASE_DOMAIN>[:porta]/sso/callback` —
# dan alamat logout back-channel-nya `<skema>://<COREERP_BASE_DOMAIN>/sso/backchannel-logout`.
# Di laptop: `http://erp.localhost:8000/sso/callback`.
#
# Sesudah terisi, SSO baru tampil pada tenant yang dinyalakan: `php artisan tenant:sso <slug>`.
COREERP_SSO_ISSUER=
COREERP_SSO_CLIENT_ID=
COREERP_SSO_CLIENT_SECRET=

# Undangan terikat SSO — operator mengundang lewat email, dan email itu wajib sudah terdaftar di
# penyedia. Memakai dua endpoint di luar OIDC yang alamatnya tidak ada di dokumen discovery, jadi
# harus disebut; kosong berarti diturunkan dari issuer dengan akhiran `/api/v1`.
#
# Kredensialnya bawaan mengikuti CLIENT_ID dan CLIENT_SECRET di atas. Isi dua kunci API di bawah
# hanya bila client kedua khusus pengelolaan didaftarkan di penyedia.
#
# Email undangan dikirim penyedia, dan tautannya mendarat di `<COREERP_BASE_DOMAIN>/undangan`.
# Alamat itu harus termasuk host yang diizinkan client ini di penyedia — domain dasar sudah termasuk
# karena alamat balik OIDC ada di sana; alamat tenant TIDAK, dan itu sebabnya tautannya mendarat di
# domain dasar lalu dialihkan.
COREERP_SSO_API_URL=
COREERP_SSO_API_CLIENT_ID=
COREERP_SSO_API_CLIENT_SECRET=
COREERP_SSO_INVITATION_APP_NAME=CoreERP
COREERP_SSO_INVITATION_DAYS=7

# Lisensi situs on-prem dikelola, dipasang agen di server pelanggan. Kosong berarti tidak ada lisensi
# yang diperiksa, dan itu bawaannya — SaaS, beli-putus, dan lingkungan lokal memang tidak memilikinya.
#
# COREERP_LICENSE_REQUIRED=true MENGUNCI: lisensi yang habis, hilang, atau bertanda tangan salah
# menahan pengguna tenant di halaman "Lisensi tidak berlaku", dan app yang tidak tercantum di lisensi
# tidak dapat dibuka. Akun provider, login, logout, dan /up tetap bekerja. Tanpa setelan ini lisensi
# hanya memunculkan peringatan dan tidak pernah mengunci. Agen menyalakannya di server on-prem dikelola.
#
# COREERP_LICENSE_PATH menunjuk `license.json`; tanda tangannya dibaca dari `license.json.sig` di
# sebelahnya. COREERP_LICENSE_PUBLIC_KEY_PATH menunjuk kunci publik rilis dalam bentuk PEM.
COREERP_LICENSE_REQUIRED=
COREERP_LICENSE_PATH=
COREERP_LICENSE_PUBLIC_KEY_PATH=
