{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@coreerp/control-plane",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run ui:build && vite build",
        "build:ssr": "npm run ui:build && vite build && vite build --ssr",
        "dev": "npm run ui:build && vite",
        "ui:build": "npm --prefix ../../packages/ui run build",
        "format": "npm run ui:build && prettier --write resources/ && prettier --config .prettierrc --no-error-on-unmatched-pattern --write \"../../modules/*/*/ui/**/*.{ts,tsx}\"",
        "format:check": "npm run ui:build && prettier --check resources/ && prettier --config .prettierrc --no-error-on-unmatched-pattern --check \"../../modules/*/*/ui/**/*.{ts,tsx}\"",
        "lint": "npm run ui:build && eslint . --fix",
        "lint:check": "npm run ui:build && eslint .",
        "types:check": "npm run ui:build && tsc --noEmit",
        "bundle:check": "node scripts/periksa-bundel.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "shadcn": "^4.13.0",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@apperp/ui": "*",
        "@base-ui/react": "^1.6.0",
        "@hookform/resolvers": "^5.4.0",
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@lottiefiles/dotlottie-react": "^0.19.9",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@shadcn/react": "^0.2.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "@xyflow/react": "^12.11.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "concurrently": "^9.0.1",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "globals": "^15.14.0",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.2",
        "react": "^19.2.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.81.0",
        "react-resizable-panels": "^4",
        "recharts": "3.8.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vaul": "^1.1.2",
        "vite": "^8.0.0",
        "zod": "^4.4.3"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
