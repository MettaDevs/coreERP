APP_NAME="Pusat Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_LEVEL=debug
SESSION_DRIVER=file
CACHE_STORE=file

# Database yang sama dengan Core, dan itu bukan sementara — lihat `config/database.php`.
#
# Nilainya harus sama persis dengan `apps/core/.env`. Kalau berbeda, konsol ini menyambung ke
# database yang salah dan daftarnya kosong tanpa satu pun pesan galat: yang terlihat hanyalah
# "belum ada lingkungan", yang juga bunyi keadaan yang benar-benar kosong.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=core_erp
DB_USERNAME=core_erp_app
DB_PASSWORD=

# Ke mana konsol ini memerintah, dan dengan kunci apa — lihat `config/core.php`.
#
# Melahirkan pelanggan tidak ditulis konsol ini ke database sendiri. Ia memanggil
# `POST {COREERP_URL}/api/internal/v1/tenants`, karena yang tahu cara menjalankan migration module,
# membaca registry module, dan menyemai data awal hanyalah Core. Menyalin alurnya ke sini berarti
# dua salinan pembuatan tenant, dan yang menyimpang di antara keduanya adalah rantai izin.
#
# Alamat yang salah setel adalah sebab paling sering layar itu gagal. Pesan galatnya menyebut
# alamat yang dicoba supaya sebabnya terbaca langsung, bukan menyamar sebagai gangguan jaringan.
COREERP_URL=http://localhost:8000

# Nilai sungguhannya tidak pernah masuk berkas yang dilacak git. Salin dari sisi Core yang
# memeriksanya; dibiarkan kosong, setiap pembuatan pelanggan ditolak Core dengan 401 — dan konsol
# menyebutkan nama setelan ini di pesannya supaya yang harus diperbaiki tidak perlu ditebak.
CONTROL_PLANE_TOKEN=

# Batas menunggu jawaban Core, dalam detik. Migration di sisi sana memang lama.
COREERP_TIMEOUT=30
