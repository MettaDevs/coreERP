APP_NAME="Pusat Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_LEVEL=debug
SESSION_DRIVER=file
CACHE_STORE=file

# Database yang sama dengan Core, dan itu bukan sementara — lihat `config/database.php`.
#
# Nilainya harus sama persis dengan `apps/core/.env`. Kalau berbeda, konsol ini menyambung ke
# database yang salah dan daftarnya kosong tanpa satu pun pesan galat: yang terlihat hanyalah
# "belum ada lingkungan", yang juga bunyi keadaan yang benar-benar kosong.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=core_erp
DB_USERNAME=core_erp_app
DB_PASSWORD=

# Ke mana konsol ini memerintah, dan dengan kunci apa — lihat `config/core.php`.
#
# Melahirkan pelanggan tidak ditulis konsol ini ke database sendiri. Ia memanggil
# `POST {COREERP_URL}/api/internal/v1/tenants`, karena yang tahu cara menjalankan migration module,
# membaca registry module, dan menyemai data awal hanyalah Core. Menyalin alurnya ke sini berarti
# dua salinan pembuatan tenant, dan yang menyimpang di antara keduanya adalah rantai izin.
#
# Alamat yang salah setel adalah sebab paling sering layar itu gagal. Pesan galatnya menyebut
# alamat yang dicoba supaya sebabnya terbaca langsung, bukan menyamar sebagai gangguan jaringan.
COREERP_URL=http://localhost:8000

# Nilai sungguhannya tidak pernah masuk berkas yang dilacak git. Salin dari sisi Core yang
# memeriksanya; dibiarkan kosong, setiap pembuatan pelanggan ditolak Core dengan 401 — dan konsol
# menyebutkan nama setelan ini di pesannya supaya yang harus diperbaiki tidak perlu ditebak.
CONTROL_PLANE_TOKEN=

# Batas menunggu jawaban Core, dalam detik. Migration di sisi sana memang lama.
COREERP_TIMEOUT=30

# Alamat tiap lingkungan yang ditampilkan di layar. Domain dasarnya WAJIB sama dengan milik Core —
# konsol hanya mencetak, Core yang merutekan, dan nilai yang berbeda menghasilkan tautan mati.
# Kosong berarti satu alamat untuk semua, dan kolom alamat tidak ditampilkan.
#
# Di laptop, tanpa proxy di depan dev server Core:
#
#   COREERP_BASE_DOMAIN=erp.localhost
#   COREERP_ADDRESS_SCHEME=http
#   COREERP_ADDRESS_PORT=8000
#
# `*.localhost` diselesaikan ke mesin sendiri oleh peramban dan oleh Windows 11, jadi tidak ada
# berkas hosts yang perlu disunting. Di server, biarkan skema dan porta kosong: `https` tanpa porta.
COREERP_BASE_DOMAIN=
COREERP_ADDRESS_SCHEME=
COREERP_ADDRESS_PORT=

# Database test, dan ia WAJIB berbeda dari DB_DATABASE di atas.
#
# Selama keduanya sama, setiap jalur yang membuat koneksi test menunjuk schema `public` akan
# mengosongkan database kerja — dan itu sudah terjadi tiga kali pada 11-12 September 2026, tanpa
# satu pun peringatan: `DatabaseTruncation` mengecualikan tabel `migrations`, sehingga yang
# tertinggal adalah skema utuh berisi nol baris. Suite hijau, exit code nol, lalu stack lokal
# kosong beberapa menit kemudian.
#
# Database terpisah menutup seluruh kelas kesalahan itu sekaligus, bukan satu jalurnya: schema mana
# pun yang ditunjuk koneksi test, ia tidak lagi berada di database yang sama dengan data kerja.
#
#   createdb core_erp_test && psql -d core_erp_test -c "CREATE SCHEMA IF NOT EXISTS coreerp_test;"
DB_TEST_DATABASE=core_erp_test

# Masuk ke konsol lewat SSO — lihat `config/sso.php`.
#
# Klien milik konsol sendiri ("CoreERP Admin") di penyedia, bukan klien Core. Alamat baliknya yang
# didaftarkan di penyedia harus persis `{APP_URL}/sso/callback`, dan logout back-channel-nya
# `{APP_URL}/sso/backchannel-logout`. Rahasianya tidak pernah masuk berkas yang dilacak git.
#
# Dibiarkan kosong, tombol SSO tidak tampil dan konsol bekerja seperti sebelumnya.
CONSOLE_SSO_ISSUER=
CONSOLE_SSO_CLIENT_ID=
CONSOLE_SSO_CLIENT_SECRET=

# Tetap `true` sampai setiap operator menghubungkan SSO-nya di halaman Akun — menghubungkan menuntut
# kata sandi. Sesudahnya `false`, dan hanya email di daftar akun darurat yang masih boleh memakainya.
CONSOLE_PASSWORD_LOGIN=true
CONSOLE_BREAK_GLASS_EMAILS=
