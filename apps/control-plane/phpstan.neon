includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    # phpstan-baseline.neon membekukan 348 temuan yang sudah ada sejak commit pertama.
    # Level 7 tidak pernah hijau, jadi langkah "Run Type Analysis" tidak pernah sampai ke
    # langkah test, dan tidak ada satu pun pull request yang benar-benar diperiksa. Membekukan
    # yang lama membuat kode baru tetap diperiksa penuh sejak hari ini.
    #
    # Berkas ini hanya boleh menyusut. Menambah baris ke dalamnya berarti menyembunyikan
    # temuan baru, dan itu ditolak saat peninjauan. Cara menyusutkannya: perbaiki temuannya,
    # lalu jalankan `composer types:check` — baris yang sudah tidak terpakai akan dilaporkan.
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - ../../modules/

    level: 7

    # Kelas module dimuat lewat pemindaian direktori, bukan lewat autoload Composer.
    # Autoload itu baru dipasang pada fase 2; sampai saat itu, tanpa baris ini setiap
    # kelas module dilaporkan tidak ditemukan.
    scanDirectories:
        - ../../modules/

    # Module yang sedang dipindah masuk dan belum dibentuk ulang tidak dianalisa. Ia masih
    # membawa kerangka Laravel dan namespace `App\` repo asalnya, jadi menganalisanya di sini
    # memulangkan ratusan temuan yang semuanya menunjuk keadaan yang memang sedang diperbaiki
    # bertahap pada F3-02 sampai F3-05 — dan menenggelamkan temuan sungguhan pada kode Core.
    #
    # Ia tetap ada di `scanDirectories` di atas, jadi kelasnya tetap dikenali bila kode Core
    # menyebutnya.
    #
    # Daftar ini dijaga tetap sama dengan `ModulSedangDipindah` oleh `ModulSedangDipindahTest`:
    # entri yang tertinggal setelah modulnya selesai dipindah membuat alur merah.
    excludePaths:
        analyse:
            # Daftarnya dijaga tetap sama dengan `App\Support\Modules\ModulTanpaAnalisaTipe`
            # oleh `ModulTanpaAnalisaTipeTest`, beserta tenggatnya. Sampai 9 September 2026
            # daftar ini dijaga sama dengan `ModulSedangDipindah`; keduanya dipisahkan pada
            # hari modul aset selesai dipindah tetapi anotasi tipenya belum ditulis. Alasan
            # lengkapnya, beserta angka terukurnya, ada di kelas itu.
            - ../../modules/apperp/management-aset (?)
            # Tanda `(?)` menyatakan jalur ini boleh belum ada. Ia memang belum ada sampai
            # F3-01 menariknya masuk, dan tanpa tanda itu PHPStan menolak jalan sama sekali.
